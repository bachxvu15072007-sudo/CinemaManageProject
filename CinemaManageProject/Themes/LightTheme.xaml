<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== LIGHT THEME (ZINC DAYLIGHT) ==================== -->

    <!-- Nền & Bề mặt (Zinc-100 -> White -> Zinc-50) -->
    <Color x:Key="BgPrimaryColor">#F4F4F5</Color>
    <Color x:Key="BgSecondaryColor">#FFFFFF</Color>
    <Color x:Key="SurfaceCardColor">#FFFFFF</Color>
    <Color x:Key="SurfaceElevatedColor">#FAFAFA</Color>
    <Color x:Key="SurfaceHoverColor">#E4E4E7</Color>
    <Color x:Key="SurfacePressedColor">#D4D4D8</Color>
    <Color x:Key="SurfaceDisabledColor">#F4F4F5</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="{StaticResource SurfaceDisabledColor}" />

    <!-- Chữ (Zinc-950 -> Zinc-600 -> Zinc-500) -->
    <Color x:Key="TextPrimaryColor">#09090B</Color>
    <Color x:Key="TextSecondaryColor">#52525B</Color>
    <Color x:Key="TextMutedColor">#71717A</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
    <Color x:Key="TextOnDangerColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="TextOnDangerBrush" Color="{StaticResource TextOnDangerColor}" />

    <!-- Viền Hairline -->
    <Color x:Key="BorderSubtleColor">#E4E4E7</Color>
    <Color x:Key="BorderStrongColor">#D1D1D6</Color>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <!-- Màu nhấn chính (Zinc Indigo tối giản) -->
    <Color x:Key="AccentPrimaryColor">#4F39F6</Color>
    <Color x:Key="AccentPrimaryHoverColor">#432DD7</Color>
    <Color x:Key="AccentPrimaryPressedColor">#5E6AD2</Color>
    <Color x:Key="AccentSoftColor">#164F39F6</Color>

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource AccentPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="{StaticResource AccentPrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

    <!-- Màu nhấn phụ / Hủy / Cảnh báo -->
    <Color x:Key="AccentDangerColor">#C70036</Color>
    <Color x:Key="AccentDangerHoverColor">#A50036</Color>
    <Color x:Key="AccentDangerPressedColor">#8B0836</Color>
    <Color x:Key="AccentDangerSoftColor">#16C70036</Color>

    <SolidColorBrush x:Key="AccentDangerBrush" Color="{StaticResource AccentDangerColor}" />
    <SolidColorBrush x:Key="AccentDangerHoverBrush" Color="{StaticResource AccentDangerHoverColor}" />
    <SolidColorBrush x:Key="AccentDangerPressedBrush" Color="{StaticResource AccentDangerPressedColor}" />
    <SolidColorBrush x:Key="AccentDangerSoftBrush" Color="{StaticResource AccentDangerSoftColor}" />

    <!-- Trạng thái hệ thống -->
    <Color x:Key="StatusSuccessColor">#007A55</Color>
    <Color x:Key="StatusWarningColor">#BB4D00</Color>
    <Color x:Key="StatusErrorColor">#C10007</Color>
    <Color x:Key="StatusInfoColor">#0084D1</Color>

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusSuccessSoftBrush" Color="#ECFDF5" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusWarningSoftBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusErrorSoftBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />
    <SolidColorBrush x:Key="StatusInfoSoftBrush" Color="#180084D1" />

    <!-- Ghế rạp chiếu phim (Clean Paper Zinc) -->
    <SolidColorBrush x:Key="SeatStandardBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="SeatStandardBorderBrush" Color="#D1D1D6" />
    <SolidColorBrush x:Key="SeatVipBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="SeatVipBorderBrush" Color="#FF8903" />
    <SolidColorBrush x:Key="SeatCoupleBrush" Color="#FFF1F2" />
    <SolidColorBrush x:Key="SeatCoupleBorderBrush" Color="#C70036" />
    <SolidColorBrush x:Key="SeatSelectedBrush" Color="#4F39F6" />
    <SolidColorBrush x:Key="SeatUnavailableBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="SeatMaintenanceBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ScreenCurveBrush" Color="#4F39F6" />

</ResourceDictionary>
