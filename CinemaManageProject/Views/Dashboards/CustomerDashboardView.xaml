<UserControl x:Class="CinemaManageProject.Views.Dashboards.CustomerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel>
        <!-- THẺ HỘI VIÊN & ĐIỂM THƯỞNG -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Style="{StaticResource BadgeBorderStyle}" Margin="0,0,0,8">
                        <TextBlock Text="{Binding TierDisplay}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="{Binding MemberName}"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Margin="0,2,0,0">
                        <Run Text="SĐT thành viên: " />
                        <Run Text="{Binding MemberPhone, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="18,12" Margin="14,0">
                    <StackPanel>
                        <TextBlock Text="ĐIỂM TÍCH LŨY" FontSize="{StaticResource FontSizeXs}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding PointsText}" FontSize="{StaticResource FontSizeXl}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="18,12" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="TỔNG CHI TIÊU" FontSize="{StaticResource FontSizeXs}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalSpentText}" FontSize="{StaticResource FontSizeXl}" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="18,12">
                    <StackPanel>
                        <TextBlock Text="VÉ ĐÃ ĐẶT" FontSize="{StaticResource FontSizeXs}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ActiveTicketsText}" FontSize="{StaticResource FontSizeXl}" FontWeight="Bold" Foreground="{DynamicResource StatusSuccessBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- PHIM ĐANG CHIẾU & SẮP CHIẾU -->
        <DockPanel Margin="0,0,0,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="Phim tại CINEVERSE"
                       Style="{StaticResource SectionTitleTextStyle}"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Tất cả" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="{StaticResource FontSizeSm}" Margin="0,0,8,0" Command="{Binding FilterCommand}" CommandParameter="All" />
                <Button Content="Đang chiếu" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="{StaticResource FontSizeSm}" Margin="0,0,8,0" Command="{Binding FilterCommand}" CommandParameter="NowShowing" />
                <Button Content="Sắp chiếu" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="{StaticResource FontSizeSm}" Command="{Binding FilterCommand}" CommandParameter="ComingSoon" />
            </StackPanel>
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Movies}" Margin="0,0,0,22">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource BadgeBorderStyle}" Background="{DynamicResource StatusInfoSoftBrush}">
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="{StaticResource FontSizeXs}" FontWeight="SemiBold" Foreground="{DynamicResource StatusInfoBrush}" />
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource BadgeBorderStyle}" Background="{DynamicResource SurfaceElevatedBrush}">
                                    <TextBlock Text="{Binding AgeRating}" FontSize="{StaticResource FontSizeXs}" FontWeight="Bold" />
                                </Border>
                            </DockPanel>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding Title}"
                                       FontSize="{StaticResource FontSizeLg}"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />

                            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock Text="{Binding Genres}"
                                           Style="{StaticResource MutedCaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding MetaInfo}"
                                           FontSize="{StaticResource FontSizeXs}"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>

                            <Border Grid.Row="3"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,10,0,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding PriceText}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- VÉ ĐÃ ĐẶT CỦA TÔI -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Vé của tôi"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Margin="0,0,0,14" />

                <DataGrid Style="{StaticResource ModernDataGridStyle}"
                          ItemsSource="{Binding MyTickets}"
                          MaxHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã vé" Binding="{Binding TicketCode}" Width="125" />
                        <DataGridTextColumn Header="Phim" Binding="{Binding MovieTitle}" Width="*" />
                        <DataGridTextColumn Header="Phòng &amp; Ghế" Binding="{Binding RoomAndSeat}" Width="180" />
                        <DataGridTextColumn Header="Suất chiếu" Binding="{Binding StartTime}" Width="140" />
                        <DataGridTextColumn Header="Giá vé" Binding="{Binding UnitPrice}" Width="100" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="115" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Bạn chưa có vé nào được đặt trong hệ thống."
                           Visibility="{Binding HasNoTickets, Converter={StaticResource BoolToVis}}"
                           Style="{StaticResource MutedCaptionTextStyle}"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
