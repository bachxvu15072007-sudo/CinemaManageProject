<Window x:Class="CinemaManageProject.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Style="{StaticResource CinemaWindowStyle}"
        Title="CINEVERSE CINEMA"
        Width="1280" Height="800"
        MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR TRÁI ==================== -->
        <Border Grid.Column="0"
                Background="#0F1011"
                BorderBrush="#23252A"
                BorderThickness="0,0,1,0"
                Padding="16,18">
            <DockPanel LastChildFill="True">
                <!-- LOGO & VAI TRÒ -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,12">
                        <Border Background="#5E6AD2"
                                Width="36" Height="36"
                                CornerRadius="8"
                                Margin="0,0,10,0">
                            <TextBlock Text="CV"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CINEVERSE"
                                       FontSize="16"
                                       FontWeight="Bold" />
                            <Border Style="{StaticResource BadgeBorderStyle}" Padding="8,2" Margin="0,2,0,0">
                                <TextBlock Text="{Binding RoleDisplay}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#5E6AD2" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- THÔNG TIN TÀI KHOẢN & ĐĂNG XUẤT -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="#23252A"
                        BorderThickness="0,1,0,0"
                        Padding="6,14,6,0"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding UserFullName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding UsernameDisplay}"
                                   Style="{StaticResource MutedCaptionTextStyle}"
                                   Margin="0,2,0,12" />
                        <Button Content="Đăng xuất"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,8"
                                Click="OnLogoutClick" />
                    </StackPanel>
                </Border>

                <!-- DANH SÁCH MENU ĐIỀU HƯỚNG -->
                <ItemsControl ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Style="{StaticResource NavMenuButtonStyle}"
                                    Tag="{Binding ActiveTag}"
                                    Margin="0,0,0,4"
                                    Click="OnSelectMenuClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ==================== VÙNG NỘI DUNG BÊN PHẢI ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOPBAR -->
            <Border Grid.Row="0"
                    Background="#0F1011"
                    BorderBrush="#23252A"
                    BorderThickness="0,0,0,1"
                    Padding="24,14">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding PageTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <Button DockPanel.Dock="Right"
                            Content="↻ Làm mới"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8"
                            Click="OnRefreshClick" />
                </DockPanel>
            </Border>

            <!-- DASHBOARD THEO VAI TRÒ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <ContentControl x:Name="DashboardHost" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
