<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================== CONVERTER DÙNG CHUNG ==================== -->

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ==================== NỀN ĐIỆN ẢNH & CHỮ ==================== -->

    <DrawingBrush x:Key="CinemaWindowBackgroundBrush" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#060609" Offset="0.0" />
                            <GradientStop Color="#0A0B10" Offset="0.55" />
                            <GradientStop Color="#060608" Offset="1.0" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.46,0.12" GradientOrigin="0.46,0.12" RadiusX="0.68" RadiusY="0.58">
                            <GradientStop Color="#485E6AD2" Offset="0.0" />
                            <GradientStop Color="#223A438F" Offset="0.48" />
                            <GradientStop Color="#0009090B" Offset="1.0" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.88,0.84" GradientOrigin="0.88,0.84" RadiusX="0.60" RadiusY="0.52">
                            <GradientStop Color="#32C70036" Offset="0.0" />
                            <GradientStop Color="#147A0024" Offset="0.5" />
                            <GradientStop Color="#0009090B" Offset="1.0" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.46,0.22" GradientOrigin="0.38,0.02" RadiusX="0.28" RadiusY="0.72">
                            <RadialGradientBrush.RelativeTransform>
                                <RotateTransform Angle="-22" CenterX="0.46" CenterY="0.22" />
                            </RadialGradientBrush.RelativeTransform>
                            <GradientStop Color="#207C86FF" Offset="0.0" />
                            <GradientStop Color="#0D5E6AD2" Offset="0.52" />
                            <GradientStop Color="#0009090B" Offset="1.0" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="CinemaWindowStyle"
           TargetType="{x:Type ui:FluentWindow}"
           BasedOn="{StaticResource {x:Type ui:FluentWindow}}">
        <Setter Property="Background" Value="{StaticResource CinemaWindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="#FAFAFA" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="ExtendsContentIntoTitleBar" Value="True" />
        <Setter Property="WindowBackdropType" Value="None" />
        <Setter Property="WindowCornerPreference" Value="Round" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FAFAFA" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FAFAFA" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FAFAFA" />
    </Style>

    <Style x:Key="MutedCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#A1A1AA" />
    </Style>

    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#A1A1AA" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ==================== CARD & BADGE ==================== -->

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#D8141516" />
        <Setter Property="BorderBrush" Value="#2B2E38" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="BadgeBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="#265E6AD2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ==================== BUTTON (KẾ THỪA TỪ WPF-UI) ==================== -->

    <Style x:Key="BaseButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#5E6AD2" />
        <Setter Property="BorderBrush" Value="#5E6AD2" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#7C86FF" />
                <Setter Property="BorderBrush" Value="#7C86FF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#4F39F6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#18181B" />
        <Setter Property="Foreground" Value="#FAFAFA" />
        <Setter Property="BorderBrush" Value="#3F3F46" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#27272A" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#34343A" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#C70036" />
        <Setter Property="BorderBrush" Value="#C70036" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E11D48" />
                <Setter Property="BorderBrush" Value="#E11D48" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#9F1239" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#A1A1AA" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#27272A" />
                <Setter Property="Foreground" Value="#FAFAFA" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#34343A" />
                <Setter Property="Foreground" Value="#FAFAFA" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="#265E6AD2" />
                <Setter Property="BorderBrush" Value="#405E6AD2" />
                <Setter Property="Foreground" Value="#5E6AD2" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="#265E6AD2" />
                <Setter Property="BorderBrush" Value="#5E6AD2" />
                <Setter Property="Foreground" Value="#FAFAFA" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PosterCardButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Background" Value="#141516" />
        <Setter Property="BorderBrush" Value="#23252A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#18181B" />
                <Setter Property="BorderBrush" Value="#3F3F46" />
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="#1B1E2E" />
                <Setter Property="BorderBrush" Value="#5E6AD2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== INPUT CONTROLS (KẾ THỪA TỪ WPF-UI) ==================== -->

    <Style x:Key="ModernTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="#18181B" />
        <Setter Property="Foreground" Value="#FAFAFA" />
        <Setter Property="CaretBrush" Value="#5E6AD2" />
        <Setter Property="BorderBrush" Value="#3F3F46" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
        <Setter Property="Background" Value="#18181B" />
        <Setter Property="Foreground" Value="#FAFAFA" />
        <Setter Property="CaretBrush" Value="#5E6AD2" />
        <Setter Property="BorderBrush" Value="#3F3F46" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="#FAFAFA" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="#18181B" />
        <Setter Property="Foreground" Value="#FAFAFA" />
        <Setter Property="BorderBrush" Value="#3F3F46" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ==================== DATAGRID ==================== -->

    <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="#141516" />
        <Setter Property="Foreground" Value="#FAFAFA" />
        <Setter Property="BorderBrush" Value="#23252A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="#141516" />
        <Setter Property="AlternatingRowBackground" Value="#18181B" />
        <Setter Property="HorizontalGridLinesBrush" Value="#23252A" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="RowHeight" Value="42" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#0F1011" />
                    <Setter Property="Foreground" Value="#A1A1AA" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="14,10" />
                    <Setter Property="BorderBrush" Value="#23252A" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="14,0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#265E6AD2" />
                            <Setter Property="Foreground" Value="#FAFAFA" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactDataGridStyle"
           TargetType="DataGrid"
           BasedOn="{StaticResource ModernDataGridStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#FAFAFA" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#141516" />
                    <Setter Property="Foreground" Value="#A1A1AA" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="8,8" />
                    <Setter Property="BorderBrush" Value="#23252A" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="#FAFAFA" />
                    <Setter Property="Padding" Value="8,8" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#265E6AD2" />
                            <Setter Property="Foreground" Value="#FAFAFA" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EllipsisCellTextStyle" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WrappingCellTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ==================== SƠ ĐỒ GHẾ ĐẶT VÉ (POS & CUSTOMER) ==================== -->

    <Style x:Key="BookingSeatButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="#18181B" />
        <Setter Property="BorderBrush" Value="#3F3F46" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FAFAFA" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCouple}" Value="True">
                <Setter Property="Width" Value="86" />
            </DataTrigger>
            <DataTrigger Binding="{Binding VisualState}" Value="VIP">
                <Setter Property="Background" Value="#265E6AD2" />
                <Setter Property="BorderBrush" Value="#5E6AD2" />
                <Setter Property="Foreground" Value="#E0E7FF" />
            </DataTrigger>
            <DataTrigger Binding="{Binding VisualState}" Value="Couple">
                <Setter Property="Background" Value="#2B193D" />
                <Setter Property="BorderBrush" Value="#A855F7" />
                <Setter Property="Foreground" Value="#F3E8FF" />
            </DataTrigger>
            <DataTrigger Binding="{Binding VisualState}" Value="Booked">
                <Setter Property="Background" Value="#27272A" />
                <Setter Property="BorderBrush" Value="#3F3F46" />
                <Setter Property="Foreground" Value="#71717A" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Opacity" Value="0.65" />
            </DataTrigger>
            <DataTrigger Binding="{Binding VisualState}" Value="Maintenance">
                <Setter Property="Background" Value="#26C70036" />
                <Setter Property="BorderBrush" Value="#E11D48" />
                <Setter Property="Foreground" Value="#FDA4AF" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Opacity" Value="0.78" />
            </DataTrigger>
            <DataTrigger Binding="{Binding VisualState}" Value="Selected">
                <Setter Property="Background" Value="#5E6AD2" />
                <Setter Property="BorderBrush" Value="#FFFFFF" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.88" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
