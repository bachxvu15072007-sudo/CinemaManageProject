<UserControl x:Class="CinemaManageProject.Views.Customer.CustomerMyTicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="988"
             d:DesignHeight="940"
             d:Background="#09090B">

    <StackPanel>
        <!-- HEADER -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Vé của tôi &amp; Lịch sử Hóa đơn"
                       Style="{StaticResource PageTitleTextStyle}"
                       Margin="0,0,0,4" />
            <TextBlock Text="Xem mã vé check-in, thông tin ghế/suất chiếu, theo dõi hóa đơn và hủy vé chờ chiếu khi cần."
                       Style="{StaticResource MutedCaptionTextStyle}" />
        </StackPanel>

        <!-- 4 KPI HỘI VIÊN -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="VÉ CHỜ CHIẾU" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding PendingCountText}" FontSize="20" FontWeight="Bold" Foreground="#FEE685" Margin="0,6,0,2" />
                    <TextBlock Text="Sẵn sàng soát vé" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="VÉ ĐÃ CHECK-IN" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding CheckedInCountText}" FontSize="20" FontWeight="Bold" Foreground="#A4F4CF" Margin="0,6,0,2" />
                    <TextBlock Text="Đã vào phòng chiếu" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="TỔNG HÓA ĐƠN" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding OrdersCountText}" FontSize="20" FontWeight="Bold" Margin="0,6,0,2" />
                    <TextBlock Text="Online &amp; Tại quầy" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="HẠNG &amp; ĐIỂM HIỆN TẠI" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding TierAndPointsText}" FontSize="18" FontWeight="Bold" Foreground="#5E6AD2" Margin="0,6,0,2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Cập nhật theo giao dịch" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- THÔNG BÁO -->
        <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#24C10007" BorderBrush="#FFC9C9" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFC9C9" FontSize="12" TextWrapping="Wrap" />
        </Border>
        <Border Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#22166534" BorderBrush="#A4F4CF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="#A4F4CF" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- DANH SÁCH VÉ + CUỐNG VÉ CHI TIẾT -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- DANH SÁCH VÉ -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <Button Content="Tất cả" Tag="{Binding AllFilterTag}" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,6,0" Click="OnFilterAllClick" />
                            <Button Content="Chờ soát vé" Tag="{Binding BookedFilterTag}" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,6,0" Click="OnFilterBookedClick" />
                            <Button Content="Đã check-in" Tag="{Binding CheckedInFilterTag}" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,6,0" Click="OnFilterCheckedInClick" />
                            <Button Content="Đã hủy" Tag="{Binding CancelledFilterTag}" Style="{StaticResource FilterChipButtonStyle}" Click="OnFilterCancelledClick" />
                        </WrapPanel>
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Padding="10,6"
                                 FontSize="12"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Tìm mã vé, tên phim, ghế..." />
                    </Grid>

                    <TextBlock Text="Không có vé nào khớp bộ lọc hiện tại."
                               Visibility="{Binding HasNoFilteredTickets, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                               Style="{StaticResource MutedCaptionTextStyle}"
                               Margin="0,6,0,6" />

                    <DataGrid Style="{StaticResource CompactDataGridStyle}"
                              ItemsSource="{Binding FilteredTickets}"
                              SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                              MaxHeight="340">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã vé" Binding="{Binding TicketCode}" Width="122" MinWidth="108" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                            <DataGridTextColumn Header="Phim" Binding="{Binding MovieTitle}" Width="*" MinWidth="135" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                            <DataGridTextColumn Header="Phòng &amp; Ghế" Binding="{Binding RoomAndSeat}" Width="142" MinWidth="124" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                            <DataGridTextColumn Header="Suất chiếu" Binding="{Binding StartTimeDisplay}" Width="114" MinWidth="102" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="96" MinWidth="86" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- CUỐNG VÉ CHI TIẾT -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Cuống vé điện tử"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Chọn một vé bên trái để xem chi tiết mã soát vé và hóa đơn."
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedTicket}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Visibility="{Binding HasSelectedTicket, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <Border Background="#1B1E2E" BorderBrush="#5E6AD2" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="MÃ VÉ SOÁT TẠI CỔNG (TICKET CODE)" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC" />
                                <TextBlock Text="{Binding SelectedTicket.TicketCode}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,4" />
                                <Border Style="{StaticResource BadgeBorderStyle}" Padding="8,3">
                                    <TextBlock Text="{Binding SelectedTicket.StatusDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#A4F4CF" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding SelectedTicket.MovieTitle}" FontSize="15" FontWeight="Bold" Foreground="#FAFAFA" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,4">
                            <Run Text="{Binding SelectedTicket.StartTimeDisplay, Mode=OneWay}" Foreground="#FAFAFA" FontWeight="SemiBold" />
                            <Run Text=" • " />
                            <Run Text="{Binding SelectedTicket.Format, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,10">
                            <Run Text="{Binding SelectedTicket.RoomAndSeat, Mode=OneWay}" Foreground="#FAFAFA" FontWeight="SemiBold" />
                            <Run Text=" (" />
                            <Run Text="{Binding SelectedTicket.SeatTypeDisplay, Mode=OneWay}" />
                            <Run Text=")" />
                        </TextBlock>

                        <!-- ĐƯỜNG RÃNH CUỐNG VÉ -->
                        <Line X1="0" X2="1" Stretch="Fill" Stroke="#3F3F46" StrokeThickness="1" StrokeDashArray="4 3" Margin="0,2,0,10" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Mã hóa đơn:" FontSize="12" Foreground="#71717A" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTicket.OrderCode}" FontSize="12" Foreground="#FAFAFA" HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Giá vé:" FontSize="12" Foreground="#71717A" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTicket.UnitPriceText}" FontSize="12" FontWeight="SemiBold" Foreground="#5E6AD2" HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Kênh / Thanh toán:" FontSize="12" Foreground="#71717A" />
                            <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="#FAFAFA" HorizontalAlignment="Right">
                                <Run Text="{Binding SelectedTicket.ChannelDisplay, Mode=OneWay}" />
                                <Run Text=" • " />
                                <Run Text="{Binding SelectedTicket.PaymentDisplay, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Left" Text="Soát vé lúc:" FontSize="12" Foreground="#71717A" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTicket.CheckedInAtDisplay}" FontSize="12" Foreground="#A1A1AA" HorizontalAlignment="Right" />
                        </DockPanel>

                        <Button Content="Hủy vé này"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding CanCancelSelectedTicket, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                Click="OnCancelTicketClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- LỊCH SỬ HÓA ĐƠN -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Lịch sử Hóa đơn của tôi"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Margin="0,0,0,12" />

                <TextBlock Text="Bạn chưa có hóa đơn đặt vé nào."
                           Visibility="{Binding HasNoOrders, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                           Style="{StaticResource MutedCaptionTextStyle}" />

                <DataGrid Style="{StaticResource CompactDataGridStyle}"
                          ItemsSource="{Binding MyOrders}"
                          MaxHeight="260">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã hóa đơn" Binding="{Binding OrderCode}" Width="130" MinWidth="116" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                        <DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAtDisplay}" Width="116" MinWidth="104" />
                        <DataGridTextColumn Header="Phim" Binding="{Binding MoviesSummary}" Width="*" MinWidth="140" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                        <DataGridTextColumn Header="Kênh" Binding="{Binding ChannelDisplay}" Width="74" MinWidth="64" />
                        <DataGridTextColumn Header="Số vé" Binding="{Binding TicketsText}" Width="66" MinWidth="58" />
                        <DataGridTextColumn Header="Giảm điểm" Binding="{Binding DiscountText}" Width="88" MinWidth="78" />
                        <DataGridTextColumn Header="Thực trả" Binding="{Binding TotalAmountText}" Width="92" MinWidth="82" />
                        <DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentDisplay}" Width="96" MinWidth="86" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="106" MinWidth="92" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
