<Window x:Class="CinemaManageProject.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Style="{StaticResource CinemaWindowStyle}"
        Title="CINEVERSE CINEMA — Đăng nhập"
        Width="470"
        SizeToContent="Height"
        MinHeight="540"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HỌA TIẾT CUỘN PHIM CHÌM -->
        <ui:SymbolIcon Grid.RowSpan="2"
                       Symbol="Filmstrip24"
                       FontSize="128"
                       Foreground="#5E6AD2"
                       Opacity="0.06"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,-10,-10"
                       IsHitTestVisible="False">
            <ui:SymbolIcon.RenderTransform>
                <RotateTransform Angle="-14" CenterX="64" CenterY="64" />
            </ui:SymbolIcon.RenderTransform>
        </ui:SymbolIcon>

        <!-- HEADER LOGO -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#5E6AD2"
                        Width="38" Height="38"
                        CornerRadius="8"
                        Margin="0,0,12,0">
                    <ui:SymbolIcon Symbol="MoviesAndTv24"
                                   FontSize="20"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CINEVERSE CINEMA"
                               FontSize="16"
                               FontWeight="Bold" />
                    <TextBlock Text="Hệ thống Quản lý &amp; Đặt vé Rạp phim"
                               Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- CARD CHÍNH -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="24">
            <StackPanel>
                <!-- THÔNG BÁO LỖI -->
                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                        Background="#24C10007"
                        BorderBrush="#FFC9C9"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,16">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FFC9C9"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- FORM ĐĂNG NHẬP -->
                <StackPanel Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Đăng nhập tài khoản"
                               Style="{StaticResource PageTitleTextStyle}"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Đăng nhập bằng tài khoản Admin, Staff hoặc Khách hàng để vào bảng điều khiển."
                               Style="{StaticResource MutedCaptionTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18" />

                    <TextBlock Text="Tên đăng nhập"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#A1A1AA"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14" />

                    <TextBlock Text="Mật khẩu"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#A1A1AA"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="LoginPasswordBox"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 KeyDown="OnLoginPasswordKeyDown"
                                 Margin="0,0,0,20" />

                    <Button Content="Đăng nhập"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OnLoginClick"
                            Margin="0,0,0,12" />

                    <Button Content="Chưa có tài khoản? Đăng ký thành viên"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="OnToggleModeClick"
                            Margin="0,0,0,14" />

                    <Border BorderBrush="#23252A"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Điền nhanh tài khoản mẫu để thử từng Dashboard:"
                                       Style="{StaticResource MutedCaptionTextStyle}"
                                       Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Admin"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,7"
                                        FontSize="12"
                                        Tag="Admin"
                                        Click="OnFillDemoClick" />
                                <Button Grid.Column="2"
                                        Content="Staff"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,7"
                                        FontSize="12"
                                        Tag="Staff"
                                        Click="OnFillDemoClick" />
                                <Button Grid.Column="4"
                                        Content="Customer"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,7"
                                        FontSize="12"
                                        Tag="Customer"
                                        Click="OnFillDemoClick" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- FORM ĐĂNG KÝ CUSTOMER -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Đăng ký hội viên mới"
                               Style="{StaticResource PageTitleTextStyle}"
                               FontSize="20"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Tạo tài khoản Khách hàng mới để đặt vé và tích điểm thành viên."
                               Style="{StaticResource MutedCaptionTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Họ và tên *" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số điện thoại *" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegEmail, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Tên đăng nhập *" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mật khẩu *" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,5" />
                            <PasswordBox x:Name="RegPasswordBox" Style="{StaticResource ModernPasswordBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Xác nhận *" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,5" />
                            <PasswordBox x:Name="RegConfirmPasswordBox" Style="{StaticResource ModernPasswordBoxStyle}" KeyDown="OnRegisterPasswordKeyDown" />
                        </StackPanel>
                    </Grid>

                    <Button Content="Tạo tài khoản &amp; Đăng nhập"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OnRegisterClick"
                            Margin="0,0,0,10" />

                    <Button Content="Đã có tài khoản? Quay lại đăng nhập"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="OnToggleModeClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
