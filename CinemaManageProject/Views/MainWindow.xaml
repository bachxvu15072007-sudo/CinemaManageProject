<ui:FluentWindow x:Class="CinemaManageProject.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Style="{StaticResource CinemaWindowStyle}"
                 Title="CINEVERSE CINEMA"
                 Width="1280" Height="800"
                 MinWidth="1080" MinHeight="660"
                 WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource CinemaWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- THANH TIÊU ĐỀ TỐI ĐỒNG BỘ (WPF-UI) -->
        <Border Grid.Row="0"
                Background="#0F1011"
                BorderBrush="#23252A"
                BorderThickness="0,0,0,1">
            <ui:TitleBar Title="CINEVERSE CINEMA"
                         Height="34">
                <ui:TitleBar.Icon>
                    <ui:SymbolIcon Symbol="MoviesAndTv24"
                                   FontSize="15"
                                   Foreground="#7C86FF" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>
        </Border>

        <!-- NỘI DUNG SHELL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== SIDEBAR TRÁI ==================== -->
            <Border x:Name="SidebarPanel"
                    Grid.Column="0"
                    Width="244"
                    Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}"
                    Background="#0F1011"
                    BorderBrush="#23252A"
                    BorderThickness="0,0,1,0"
                    Padding="16,18">
                <DockPanel LastChildFill="True">
                    <!-- LOGO & VAI TRÒ -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,12">
                            <Border Background="#5E6AD2"
                                    Width="36" Height="36"
                                    CornerRadius="8"
                                    Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="MoviesAndTv24"
                                               FontSize="19"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CINEVERSE"
                                           FontSize="16"
                                           FontWeight="Bold" />
                                <Border Style="{StaticResource BadgeBorderStyle}" Padding="8,2" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding RoleDisplay}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#5E6AD2" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- THÔNG TIN TÀI KHOẢN & ĐĂNG XUẤT -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="#23252A"
                            BorderThickness="0,1,0,0"
                            Padding="6,14,6,0"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding UserFullName}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UsernameDisplay}"
                                       Style="{StaticResource MutedCaptionTextStyle}"
                                       Margin="0,2,0,12" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,8"
                                    Click="OnLogoutClick">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="SignOut24"
                                                   FontSize="15"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   Margin="0,0,7,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="Đăng xuất"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- DANH SÁCH MENU ĐIỀU HƯỚNG -->
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavMenuButtonStyle}"
                                        Tag="{Binding ActiveTag}"
                                        Margin="0,0,0,4"
                                        Click="OnSelectMenuClick">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}"
                                                       FontSize="16"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ==================== VÙNG NỘI DUNG BÊN PHẢI ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- TOPBAR -->
                <Border Grid.Row="0"
                        Background="#0F1011"
                        BorderBrush="#23252A"
                        BorderThickness="0,0,0,1"
                        Padding="20,12,24,12">
                    <DockPanel LastChildFill="False">
                        <Button x:Name="SidebarToggleButton"
                                DockPanel.Dock="Left"
                                ToolTip="{Binding SidebarToggleToolTip}"
                                Style="{StaticResource GhostButtonStyle}"
                                Width="34"
                                Height="34"
                                Padding="0"
                                Margin="0,0,10,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                VerticalAlignment="Center"
                                Click="OnToggleSidebarClick">
                            <ui:SymbolIcon Symbol="{Binding SidebarToggleSymbol}"
                                           FontSize="18"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>

                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding PageTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,7"
                                Click="OnRefreshClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSync24"
                                               FontSize="14"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="Làm mới"
                                           FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- HỌA TIẾT DẢI PHIM CHÌM -->
                <ui:SymbolIcon Grid.Row="1"
                               Symbol="Filmstrip24"
                               FontSize="190"
                               Foreground="#5E6AD2"
                               Opacity="0.045"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,18,12"
                               IsHitTestVisible="False">
                    <ui:SymbolIcon.RenderTransform>
                        <RotateTransform Angle="-14" CenterX="95" CenterY="95" />
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>

                <!-- DASHBOARD THEO VAI TRÒ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                    <ContentControl x:Name="DashboardHost" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
