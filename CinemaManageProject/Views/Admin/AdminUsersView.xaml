<UserControl x:Class="CinemaManageProject.Views.Admin.AdminUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="988"
             d:DesignHeight="920"
             d:Background="#09090B">

    <UserControl.Resources>
        <Style x:Key="UsersTableStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource CompactDataGridStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNoUsers}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ==================== HEADER ==================== -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#265E6AD2"
                        BorderBrush="#5E6AD2"
                        BorderThickness="1"
                        CornerRadius="10"
                        Width="42"
                        Height="42"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <Path Style="{StaticResource CinemaVectorIconStyle}"
                          Data="{StaticResource UsersGroupIconGeometry}"
                          Width="20"
                          Height="20"
                          Stroke="#A5B4FC"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Nhân sự &amp; Tài khoản"
                               Style="{StaticResource PageTitleTextStyle}"
                               Margin="0,0,0,3" />
                    <TextBlock Text="Quản lý tài khoản nhân viên và hội viên (tài khoản Quản trị viên gốc được bảo vệ, không thêm mới Admin khác)."
                               Style="{StaticResource MutedCaptionTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Button x:Name="NewUserButton"
                    Grid.Column="2"
                    Content="+ Thêm tài khoản"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Center"
                    Click="OnNewUserClick" />
        </Grid>

        <!-- ==================== 4 THẺ KPI ==================== -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="TỔNG TÀI KHOẢN" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TotalUsersCountText}" FontSize="18" FontWeight="Bold" Foreground="#5E6AD2" Margin="0,7,0,2" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="NHÂN SỰ (STAFF)" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StaffCountText}" FontSize="18" FontWeight="Bold" Margin="0,7,0,2" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="HỘI VIÊN (CUSTOMER)" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CustomerCountText}" FontSize="18" FontWeight="Bold" Margin="0,7,0,2" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="TÀI KHOẢN ĐÃ KHÓA" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LockedUsersCountText}" FontSize="18" FontWeight="Bold" Foreground="#FEE685" Margin="0,7,0,2" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== THANH TÌM KIẾM & BỘ LỌC ==================== -->
        <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tìm kiếm (tên đăng nhập, họ tên, SĐT, email)"
                               Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Height="38"
                             Padding="12,0"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Vai trò" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                              Height="38"
                              ItemsSource="{Binding RoleFilterOptions}"
                              SelectedItem="{Binding SelectedRoleFilterOption, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Trạng thái" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                              Height="38"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilterOption, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                </StackPanel>

                <Button x:Name="ResetFiltersButton"
                        Grid.Column="6"
                        Content="Đặt lại"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="38"
                        Padding="14,0"
                        VerticalAlignment="Bottom"
                        Click="OnResetFiltersClick" />
            </Grid>
        </Border>

        <!-- ==================== BẢNG DANH SÁCH TÀI KHOẢN (FULL CHIỀU NGANG) ==================== -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Danh sách Tài khoản"
                               Style="{StaticResource SectionTitleTextStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding ResultCountText}"
                               Style="{StaticResource MutedCaptionTextStyle}"
                               VerticalAlignment="Center" />
                </Grid>

                <Border Visibility="{Binding HasNoUsers, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                        Background="#18181B"
                        BorderBrush="#23252A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,24">
                    <TextBlock Text="Không tìm thấy tài khoản nào phù hợp với bộ lọc."
                               Style="{StaticResource MutedCaptionTextStyle}"
                               HorizontalAlignment="Center" />
                </Border>

                <DataGrid x:Name="UsersDataGrid"
                          Style="{StaticResource UsersTableStyle}"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          MaxHeight="270">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="110" MinWidth="96" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                        <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="1.2*" MinWidth="118" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                        <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleDisplay}" Width="108" MinWidth="98" />
                        <DataGridTextColumn Header="Số điện thoại" Binding="{Binding Phone}" Width="108" MinWidth="98" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="94" MinWidth="86" />
                        <DataGridTextColumn Header="Hoạt động / Hạng" Binding="{Binding ActivitySummaryText}" Width="1.15*" MinWidth="114" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                        <DataGridTextColumn Header="Đăng nhập cuối" Binding="{Binding LastLoginDisplay}" SortMemberPath="LastLoginAtSql" Width="122" MinWidth="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- ==================== FORM CHI TIẾT TÀI KHOẢN (2 CỘT CÂN ĐỐI) ==================== -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding FormHeaderText, FallbackValue='Thêm tài khoản mới'}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="2"
                            Style="{StaticResource BadgeBorderStyle}"
                            CornerRadius="8"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding FormModeBadge, FallbackValue='THÊM MỚI'}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#5E6AD2" />
                    </Border>
                </Grid>

                <!-- BANNERS THÔNG BÁO -->
                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                        Background="#24C10007"
                        BorderBrush="#FFC9C9"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FFC9C9"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <Border Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                        Background="#22166534"
                        BorderBrush="#A4F4CF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="#A4F4CF"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <Border Visibility="{Binding IsProtectedAdmin, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                        Background="#265E6AD2"
                        BorderBrush="#5E6AD2"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <TextBlock Text="{Binding ProtectedAdminNotice}"
                               Foreground="#E0E7FF"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- 2 CỘT TRƯỜNG NHẬP LIỆU -->
                <Grid IsEnabled="{Binding IsEditableUser, FallbackValue=True}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI FORM -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vai trò *" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                                  Height="38"
                                  ItemsSource="{Binding RoleFormOptions}"
                                  SelectedItem="{Binding SelectedFormRoleOption, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Visibility="{Binding CanSelectRole, Converter={StaticResource BoolToVis}, FallbackValue=Visible}"
                                  Margin="0,0,0,12" />
                        <Border Height="38"
                                Background="#18181B"
                                BorderBrush="#23252A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,0"
                                Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanSelectRole}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FixedRoleDisplayText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#A5B4FC"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Tên đăng nhập *" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"
                                 Padding="12,0"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="{Binding PasswordFieldLabel, FallbackValue='Mật khẩu * (>= 6 ký tự)'}"
                                   Style="{StaticResource FieldLabelTextStyle}" />
                        <PasswordBox x:Name="UserPasswordBox"
                                     Style="{StaticResource ModernPasswordBoxStyle}"
                                     Height="38"
                                     Margin="0,0,0,12" />

                        <CheckBox Content="Tài khoản đang hoạt động (cho phép đăng nhập)"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  IsChecked="{Binding IsActiveAccount, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditActiveStatus, FallbackValue=True}"
                                  Margin="0,4,0,12" />

                        <Border Visibility="{Binding ShowMemberReadOnlyCard, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                Background="#18181B"
                                BorderBrush="#23252A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Hạng thẻ" FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding MemberTierText}" FontSize="13" FontWeight="Bold" Foreground="#A5B4FC" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Điểm tích lũy" FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding MemberPointsText}" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tổng chi tiêu" FontSize="11" Foreground="#71717A" />
                                    <TextBlock Text="{Binding MemberTotalSpentText}" FontSize="13" FontWeight="SemiBold" Foreground="#A4F4CF" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- CỘT PHẢI FORM -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Họ và tên *" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"
                                 Padding="12,0"
                                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="{Binding PhoneFieldLabel, FallbackValue='Số điện thoại'}"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"
                                 Padding="12,0"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="Email" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"
                                 Padding="12,0"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" />

                        <StackPanel Visibility="{Binding IsCustomerFormMode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <TextBlock Text="Ngày sinh (dd/MM/yyyy)" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Height="38"
                                     Padding="12,0"
                                     Text="{Binding DateOfBirthText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- CỤM NÚT HÀNH ĐỘNG -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SaveUserButton"
                            Grid.Column="0"
                            Content="Lưu tài khoản"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsEditableUser, FallbackValue=True}"
                            Click="OnSaveUserClick" />
                    <Button x:Name="ToggleActiveButton"
                            Grid.Column="2"
                            Content="{Binding QuickLockButtonLabel, FallbackValue='Khóa tài khoản'}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding CanToggleActiveQuick, FallbackValue=False}"
                            Click="OnToggleActiveClick" />
                    <Button Grid.Column="4"
                            Content="Làm mới"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnResetFormClick" />
                    <Button x:Name="DeleteUserButton"
                            Grid.Column="6"
                            Content="Xóa tài khoản"
                            Style="{StaticResource DangerButtonStyle}"
                            IsEnabled="{Binding CanClickDelete, FallbackValue=False}"
                            Click="OnDeleteUserClick" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
