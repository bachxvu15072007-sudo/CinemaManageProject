<UserControl x:Class="CinemaManageProject.Views.Staff.StaffDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel>
        <TextBlock Text="{Binding StaffGreeting}"
                   Style="{StaticResource PageTitleTextStyle}"
                   Margin="0,0,0,4" />
        <TextBlock Text="Theo dõi doanh số quầy cá nhân, số ghế trống theo suất và tình trạng vé chờ check-in."
                   Style="{StaticResource MutedCaptionTextStyle}"
                   Margin="0,0,0,20" />

        <!-- 4 THẺ KPI CA LÀM VIỆC -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="VÉ TÔI ĐÃ BÁN" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding MyTicketsText}" FontSize="20" FontWeight="Bold" Margin="0,8,0,4" />
                    <TextBlock Text="Tổng vé tại quầy" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="DOANH THU QUẦY CỦA TÔI" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding MyRevenueText}" FontSize="20" FontWeight="Bold" Foreground="#5E6AD2" Margin="0,8,0,4" />
                    <TextBlock Text="Hóa đơn hợp lệ" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="SUẤT ĐANG MỞ BÁN" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding OpenShowtimesText}" FontSize="20" FontWeight="Bold" Foreground="#74D4FF" Margin="0,8,0,4" />
                    <TextBlock Text="Sẵn sàng phục vụ" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="VÉ CHỜ SOÁT CHECK-IN" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding PendingCheckInText}" FontSize="20" FontWeight="Bold" Foreground="#FEE685" Margin="0,8,0,4" />
                    <TextBlock Text="Chưa vào phòng chiếu" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- SUẤT CHIẾU MỞ BÁN & GIAO DỊCH CỦA TÔI -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Suất chiếu mở bán &amp; Ghế trống"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,14" />
                    <DataGrid Style="{StaticResource ModernDataGridStyle}"
                              ItemsSource="{Binding OpenShowtimes}"
                              MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Phim" Binding="{Binding MovieTitle}" Width="*" />
                            <DataGridTextColumn Header="Tuổi" Binding="{Binding AgeRating}" Width="55" />
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="115" />
                            <DataGridTextColumn Header="Giờ" Binding="{Binding StartTime}" Width="100" />
                            <DataGridTextColumn Header="Ghế trống" Binding="{Binding SeatsLeft}" Width="100" />
                            <DataGridTextColumn Header="Giá vé" Binding="{Binding Price}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Giao dịch quầy gần đây"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,14" />
                    <ItemsControl ItemsSource="{Binding MyRecentOrders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#18181B"
                                        BorderBrush="#23252A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding OrderCode}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Amount}"
                                                   FontWeight="Bold"
                                                   Foreground="#5E6AD2" />

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource MutedCaptionTextStyle}">
                                            <Run Text="{Binding CustomerName, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding TotalTickets, Mode=OneWay}" />
                                            <Run Text=" vé" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Margin="0,4,0,0"
                                                   Text="{Binding Payment}"
                                                   Style="{StaticResource MutedCaptionTextStyle}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
