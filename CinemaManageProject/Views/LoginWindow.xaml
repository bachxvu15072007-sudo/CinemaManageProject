<Window x:Class="CinemaManageProject.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Style="{StaticResource CinemaWindowStyle}"
        Title="CINEVERSE CINEMA — Đăng nhập"
        Width="470"
        SizeToContent="Height"
        MinHeight="540"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER LOGO + ĐỔI THEME -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource AccentPrimaryBrush}"
                        Width="38" Height="38"
                        CornerRadius="{StaticResource RadiusMd}"
                        Margin="0,0,12,0">
                    <TextBlock Text="CV"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="{DynamicResource TextOnAccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CINEVERSE CINEMA"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="Bold" />
                    <TextBlock Text="Hệ thống Quản lý &amp; Đặt vé Rạp phim"
                               Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Content="{Binding ThemeButtonText}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,7"
                    FontSize="{StaticResource FontSizeSm}"
                    Command="{Binding ToggleThemeCommand}" />
        </DockPanel>

        <!-- CARD CHÍNH -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="24">
            <StackPanel>
                <!-- THÔNG BÁO LỖI -->
                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource StatusErrorSoftBrush}"
                        BorderBrush="{DynamicResource StatusErrorBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="12,10"
                        Margin="0,0,0,16">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource StatusErrorBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- FORM ĐĂNG NHẬP -->
                <StackPanel Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Đăng nhập tài khoản"
                               Style="{StaticResource PageTitleTextStyle}"
                               FontSize="{StaticResource FontSizeXl}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Đăng nhập bằng tài khoản Admin, Staff hoặc Khách hàng để vào bảng điều khiển."
                               Style="{StaticResource MutedCaptionTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18" />

                    <TextBlock Text="Tên đăng nhập"
                               FontSize="{StaticResource FontSizeSm}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14" />

                    <TextBlock Text="Mật khẩu"
                               FontSize="{StaticResource FontSizeSm}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="LoginPasswordBox"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 KeyDown="OnLoginPasswordKeyDown"
                                 Margin="0,0,0,20" />

                    <Button Content="Đăng nhập"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OnLoginClick"
                            Margin="0,0,0,12" />

                    <Button Content="Chưa có tài khoản? Đăng ký thành viên"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding ToggleModeCommand}"
                            Margin="0,0,0,14" />

                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Điền nhanh tài khoản mẫu để thử từng Dashboard:"
                                       Style="{StaticResource MutedCaptionTextStyle}"
                                       Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Admin"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,7"
                                        FontSize="{StaticResource FontSizeSm}"
                                        Command="{Binding FillDemoCommand}"
                                        CommandParameter="Admin" />
                                <Button Grid.Column="2"
                                        Content="Staff"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,7"
                                        FontSize="{StaticResource FontSizeSm}"
                                        Command="{Binding FillDemoCommand}"
                                        CommandParameter="Staff" />
                                <Button Grid.Column="4"
                                        Content="Customer"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,7"
                                        FontSize="{StaticResource FontSizeSm}"
                                        Command="{Binding FillDemoCommand}"
                                        CommandParameter="Customer" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- FORM ĐĂNG KÝ CUSTOMER -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Đăng ký hội viên mới"
                               Style="{StaticResource PageTitleTextStyle}"
                               FontSize="{StaticResource FontSizeXl}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Tạo tài khoản Khách hàng mới để đặt vé và tích điểm thành viên."
                               Style="{StaticResource MutedCaptionTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Họ và tên *" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số điện thoại *" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegEmail, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Tên đăng nhập *" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mật khẩu *" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                            <PasswordBox x:Name="RegPasswordBox" Style="{StaticResource ModernPasswordBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Xác nhận *" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                            <PasswordBox x:Name="RegConfirmPasswordBox" Style="{StaticResource ModernPasswordBoxStyle}" KeyDown="OnRegisterPasswordKeyDown" />
                        </StackPanel>
                    </Grid>

                    <Button Content="Tạo tài khoản &amp; Đăng nhập"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OnRegisterClick"
                            Margin="0,0,0,10" />

                    <Button Content="Đã có tài khoản? Quay lại đăng nhập"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding ToggleModeCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
