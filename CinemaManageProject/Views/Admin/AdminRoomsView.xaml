<UserControl x:Class="CinemaManageProject.Views.Admin.AdminRoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="988"
             d:DesignHeight="860"
             d:Background="#09090B">

    <UserControl.Resources>
        <Style x:Key="SeatCellButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCouple}" Value="True">
                    <Setter Property="Width" Value="86" />
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="VIP">
                    <Setter Property="Background" Value="#265E6AD2" />
                    <Setter Property="BorderBrush" Value="#5E6AD2" />
                    <Setter Property="Foreground" Value="#E0E7FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="Couple">
                    <Setter Property="Background" Value="#2B193D" />
                    <Setter Property="BorderBrush" Value="#A855F7" />
                    <Setter Property="Foreground" Value="#F3E8FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="Maintenance">
                    <Setter Property="Background" Value="#26C70036" />
                    <Setter Property="BorderBrush" Value="#E11D48" />
                    <Setter Property="Foreground" Value="#FDA4AF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ==================== HEADER ==================== -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Quản lý Phòng &amp; Sơ đồ Ghế"
                       Style="{StaticResource PageTitleTextStyle}"
                       Margin="0,0,0,4" />
            <TextBlock Text="Thông số phòng và hạng ghế cố định theo thiết kế vật lý của rạp. Bấm vào ghế để kiểm tra đơn đặt vé và bật/tắt trạng thái bảo trì."
                       Style="{StaticResource MutedCaptionTextStyle}" />
        </StackPanel>

        <!-- ==================== THÔNG BÁO LỖI / THÀNH CÔNG ==================== -->
        <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#24C10007"
                BorderBrush="#FFC9C9"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,14">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#FFC9C9"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <Border Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#22166534"
                BorderBrush="#A4F4CF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,14">
            <TextBlock Text="{Binding SuccessMessage}"
                       Foreground="#A4F4CF"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <!-- ==================== NỘI DUNG CHÍNH 2 CỘT ==================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: DANH SÁCH PHÒNG & THÔNG SỐ CHỈ XEM -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Danh sách Phòng chiếu"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="0,0,0,12" />

                        <DataGrid Style="{StaticResource ModernDataGridStyle}"
                                  ItemsSource="{Binding Rooms}"
                                  SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                                  MaxHeight="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên phòng" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Loại" Binding="{Binding RoomTypeDisplay}" Width="86" />
                                <DataGridTextColumn Header="Sức chứa" Binding="{Binding TotalSeatsText}" Width="74" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="84" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding SelectedRoom.Name, FallbackValue='Thông tin Phòng chiếu'}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Style="{StaticResource BadgeBorderStyle}">
                                <TextBlock Text="CỐ ĐỊNH"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#5E6AD2" />
                            </Border>
                        </DockPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Loại phòng:" FontSize="12" Foreground="#71717A" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedRoom.RoomTypeDisplay, FallbackValue='-'}" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Kích thước:" FontSize="12" Foreground="#71717A" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedRoom.DimensionsText, FallbackValue='-'}" FontSize="13" Foreground="#FAFAFA" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tình trạng ghế:" FontSize="12" Foreground="#71717A" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedRoom.SeatSummaryText, FallbackValue='-'}" FontSize="13" Foreground="#FAFAFA" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Phân bổ ghế:" FontSize="12" Foreground="#71717A" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedRoom.SeatBreakdownText, FallbackValue='-'}" FontSize="13" Foreground="#A1A1AA" TextWrapping="Wrap" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Phụ thu phòng:" FontSize="12" Foreground="#71717A" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedRoom.SurchargeText, FallbackValue='-'}" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Trạng thái phòng:" FontSize="12" Foreground="#71717A" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedRoom.StatusDisplay, FallbackValue='-'}" FontSize="13" FontWeight="SemiBold" Foreground="#A4F4CF" />
                        </Grid>

                        <Border Background="#18181B"
                                BorderBrush="#23252A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <TextBlock Text="Loại phòng, kích thước lưới và hạng ghế (Thường / VIP / Đôi) thuộc bản chất cố định của phòng chiếu, không thể chỉnh sửa."
                                       FontSize="11"
                                       Foreground="#A1A1AA"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- CỘT PHẢI: SƠ ĐỒ GHẾ THEO HÀNG & KIỂM TRA ĐƠN ĐẶT / BẢO TRÌ GHẾ -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding SeatMapHeader, FallbackValue='Sơ đồ Ghế'}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SeatMapSubtitle, FallbackValue='Chọn một phòng để xem sơ đồ ghế.'}"
                               Style="{StaticResource MutedCaptionTextStyle}"
                               Margin="0,0,0,14" />

                    <!-- CHÚ THÍCH MÀU SẮC -->
                    <WrapPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                            <Border Width="14" Height="14" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                            <TextBlock Text="Thường (×1.00)" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                            <Border Width="14" Height="14" Background="#265E6AD2" BorderBrush="#5E6AD2" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                            <TextBlock Text="VIP (×1.25)" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                            <Border Width="26" Height="14" Background="#2B193D" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                            <TextBlock Text="Ghế Đôi (×2.00)" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="14" Height="14" Background="#26C70036" BorderBrush="#E11D48" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                            <TextBlock Text="Bảo trì (Không cho đặt)" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- MÀN HÌNH CHIẾU -->
                    <Border Background="#18181B"
                            BorderBrush="#3F3F46"
                            BorderThickness="0,2,0,0"
                            CornerRadius="6"
                            Padding="16,6"
                            Margin="24,0,24,18">
                        <TextBlock Text="MÀN HÌNH CHIẾU"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#A1A1AA"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <!-- SƠ ĐỒ GHẾ THEO HÀNG (GHẾ ĐÔI DÀI GẤP ĐÔI) -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="420"
                                  Margin="0,0,0,18">
                        <ItemsControl ItemsSource="{Binding SeatRows}" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding RowLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#71717A"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Seats}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding SeatCode}"
                                                            Style="{StaticResource SeatCellButtonStyle}"
                                                            Click="OnSeatClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- PANEL CHI TIẾT GHẾ ĐANG CHỌN & ĐƠN HÀNG ĐÃ ĐẶT -->
                    <Border Background="#18181B"
                            BorderBrush="#23252A"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <Grid>
                            <TextBlock Text="Bấm vào một ghế bất kỳ trên sơ đồ phía trên để xem thông tin cố định của ghế, kiểm tra đơn hàng đã đặt vào ghế và bật/tắt bảo trì."
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCaptionTextStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedSeat}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Visibility="{Binding HasSelectedSeat, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding SelectedSeat.SeatCode}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#FAFAFA"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                            <Border Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedSeat.SeatTypeDisplay}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#5E6AD2" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock FontSize="13" Foreground="#A1A1AA" Margin="0,0,0,4">
                                            <Run Text="{Binding SelectedSeat.PositionText, Mode=OneWay}" />
                                            <Run Text=" • Hệ số giá: " />
                                            <Run Text="{Binding SelectedSeat.MultiplierText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        </TextBlock>

                                        <TextBlock FontSize="13" Foreground="#A1A1AA">
                                            <Run Text="Trạng thái: " />
                                            <Run Text="{Binding SelectedSeat.StatusDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="{Binding SeatActionLabel}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            VerticalAlignment="Center"
                                            Click="OnToggleSeatAvailableClick" />
                                </Grid>

                                <Border Height="1" Background="#23252A" Margin="0,0,0,12" />

                                <TextBlock Text="{Binding SeatOrdersSummaryText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FAFAFA"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Ghế này hiện chưa có đơn hàng / vé nào trong hệ thống."
                                           Visibility="{Binding HasNoSeatOrders, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                           FontSize="12"
                                           Foreground="#71717A" />

                                <DataGrid ItemsSource="{Binding SeatOrders}"
                                          MaxHeight="170">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNoSeatOrders}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderCode}" Width="115" />
                                        <DataGridTextColumn Header="Mã vé" Binding="{Binding TicketCode}" Width="115" />
                                        <DataGridTextColumn Header="Phim" Binding="{Binding MovieTitle}" Width="*" />
                                        <DataGridTextColumn Header="Suất chiếu" Binding="{Binding ShowtimeStart}" Width="115" />
                                        <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="125" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TicketStatus}" Width="95" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
