<UserControl x:Class="CinemaManageProject.Views.Staff.StaffCustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="988"
             d:DesignHeight="900"
             d:Background="#09090B">

    <StackPanel>
        <!-- HEADER -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Tra cứu &amp; Đăng ký Khách hàng"
                       Style="{StaticResource PageTitleTextStyle}"
                       Margin="0,0,0,4" />
            <TextBlock Text="Tìm nhanh hội viên theo SĐT/họ tên, xem điểm thưởng, lịch sử hóa đơn và mở thẻ hội viên trực tiếp tại quầy."
                       Style="{StaticResource MutedCaptionTextStyle}" />
        </StackPanel>

        <!-- 4 KPI KHÁCH HÀNG -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="TỔNG HỘI VIÊN" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding TotalCustomersText}" FontSize="20" FontWeight="Bold" Margin="0,6,0,2" />
                    <TextBlock Text="Đang lưu trong hệ thống" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="HẠNG BẠC TRỞ LÊN" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding SilverPlusText}" FontSize="20" FontWeight="Bold" Foreground="#FEE685" Margin="0,6,0,2" />
                    <TextBlock Text="Silver / Gold / Platinum" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="LIÊN KẾT TÀI KHOẢN APP" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding AppLinkedText}" FontSize="20" FontWeight="Bold" Foreground="#5E6AD2" Margin="0,6,0,2" />
                    <TextBlock Text="Có thể tự đặt vé online" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="ĐĂNG KÝ TẠI QUẦY" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding CounterOnlyText}" FontSize="20" FontWeight="Bold" Foreground="#A4F4CF" Margin="0,6,0,2" />
                    <TextBlock Text="Tích điểm qua số điện thoại" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- THÔNG BÁO -->
        <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#24C10007" BorderBrush="#FFC9C9" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFC9C9" FontSize="12" TextWrapping="Wrap" />
        </Border>
        <Border Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#22166534" BorderBrush="#A4F4CF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="#A4F4CF" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- DANH SÁCH HỘI VIÊN -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <Button Content="Tất cả" Tag="{Binding AllTierTag}" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,6,0" Click="OnFilterAllClick" />
                        <Button Content="Member" Tag="{Binding MemberTierTag}" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,6,0" Click="OnFilterMemberClick" />
                        <Button Content="Silver" Tag="{Binding SilverTierTag}" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,6,0" Click="OnFilterSilverClick" />
                        <Button Content="Gold" Tag="{Binding GoldTierTag}" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,6,0" Click="OnFilterGoldClick" />
                        <Button Content="Platinum" Tag="{Binding PlatinumTierTag}" Style="{StaticResource FilterChipButtonStyle}" Click="OnFilterPlatinumClick" />
                    </WrapPanel>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Padding="10,6"
                             FontSize="13"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Tìm theo SĐT, họ tên, email hoặc username..." />

                    <Button Grid.Column="3"
                            Content="+ Đăng ký hội viên quầy"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,7"
                            FontSize="13"
                            Click="OnNewCustomerClick" />
                </Grid>

                <DataGrid Style="{StaticResource CompactDataGridStyle}"
                          ItemsSource="{Binding FilteredCustomers}"
                          SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                          MaxHeight="270">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="*" MinWidth="150" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                        <DataGridTextColumn Header="Số điện thoại" Binding="{Binding Phone}" Width="112" MinWidth="100" />
                        <DataGridTextColumn Header="Hạng thẻ" Binding="{Binding TierDisplay}" Width="82" MinWidth="74" />
                        <DataGridTextColumn Header="Điểm thưởng" Binding="{Binding LoyaltyPointsText}" Width="96" MinWidth="84" />
                        <DataGridTextColumn Header="Tổng chi tiêu" Binding="{Binding TotalSpentText}" Width="112" MinWidth="98" />
                        <DataGridTextColumn Header="Tài khoản" Binding="{Binding AccountDisplay}" Width="128" MinWidth="110" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                        <DataGridTextColumn Header="Giao dịch" Binding="{Binding OrderSummaryText}" Width="136" MinWidth="118" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- CHI TIẾT & ĐĂNG KÝ + LỊCH SỬ HÓA ĐƠN -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- FORM THÔNG TIN / ĐĂNG KÝ TẠI QUẦY -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding FormHeader}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <!-- TÓM TẮT HẠNG & ĐIỂM (KHI ĐANG XEM HỘI VIÊN) -->
                    <Border Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                            Background="#18181B" BorderBrush="#23252A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="HẠNG &amp; ĐIỂM" FontSize="10" FontWeight="Bold" Foreground="#71717A" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FEE685" Margin="0,2,0,0">
                                    <Run Text="{Binding SelectedCustomer.TierDisplay, Mode=OneWay}" />
                                    <Run Text=" • " />
                                    <Run Text="{Binding SelectedCustomer.LoyaltyPointsText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TỔNG CHI TIÊU" FontSize="10" FontWeight="Bold" Foreground="#71717A" />
                                <TextBlock Text="{Binding SelectedCustomer.TotalSpentText}" FontSize="13" FontWeight="SemiBold" Foreground="#5E6AD2" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Họ và tên *" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Padding="10,7" FontSize="13" Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <TextBlock Text="Số điện thoại *" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Padding="10,7" FontSize="13" Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <TextBlock Text="Email (tùy chọn)" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Padding="10,7" FontSize="13" Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <TextBlock Text="Ngày sinh (yyyy-MM-dd, tùy chọn)" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Padding="10,7" FontSize="13" Text="{Binding EditDateOfBirth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <Button Content="{Binding SaveButtonLabel}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OnSaveCustomerClick" />
                </StackPanel>
            </Border>

            <!-- LỊCH SỬ ĐƠN HÀNG CỦA HỘI VIÊN -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Lịch sử Hóa đơn &amp; Vé của Hội viên"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Hội viên này chưa có hóa đơn nào (hoặc đang ở chế độ đăng ký hội viên mới)."
                               Visibility="{Binding HasNoOrderHistory, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                               Style="{StaticResource MutedCaptionTextStyle}"
                               Margin="0,4,0,8" />

                    <DataGrid Style="{StaticResource CompactDataGridStyle}"
                              ItemsSource="{Binding OrderHistory}"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderCode}" Width="126" MinWidth="112" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                            <DataGridTextColumn Header="Ngày đặt" Binding="{Binding CreatedAtDisplay}" Width="114" MinWidth="102" />
                            <DataGridTextColumn Header="Phim" Binding="{Binding MoviesSummary}" Width="*" MinWidth="135" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                            <DataGridTextColumn Header="Vé" Binding="{Binding TicketsText}" Width="56" MinWidth="50" />
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmountText}" Width="88" MinWidth="80" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="96" MinWidth="86" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
