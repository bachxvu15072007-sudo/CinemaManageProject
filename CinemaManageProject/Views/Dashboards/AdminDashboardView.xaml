<UserControl x:Class="CinemaManageProject.Views.Dashboards.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel>
        <!-- HEADER MỞ ĐẦU -->
        <TextBlock Text="Tổng quan Vận hành Rạp"
                   Style="{StaticResource PageTitleTextStyle}"
                   Margin="0,0,0,4" />
        <TextBlock Text="Theo dõi doanh thu, tình trạng vé phát hành, suất chiếu và cơ sở hạ tầng phòng chiếu."
                   Style="{StaticResource MutedCaptionTextStyle}"
                   Margin="0,0,0,20" />

        <!-- 4 THẺ KPI -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="TỔNG DOANH THU" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding TotalRevenueText}" FontSize="20" FontWeight="Bold" Foreground="#5E6AD2" Margin="0,8,0,4" />
                    <TextBlock Text="{Binding TodayRevenueText}" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="VÉ ĐÃ PHÁT HÀNH" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding TotalTicketsText}" FontSize="20" FontWeight="Bold" Margin="0,8,0,4" />
                    <TextBlock Text="{Binding CheckedInSubText}" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="DANH MỤC PHIM" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding MoviesCountText}" FontSize="20" FontWeight="Bold" Margin="0,8,0,4" />
                    <TextBlock Text="{Binding ComingSoonSubText}" Style="{StaticResource MutedCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="PHÒNG CHIẾU HOẠT ĐỘNG" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                    <TextBlock Text="{Binding RoomsText}" FontSize="20" FontWeight="Bold" Margin="0,8,0,4" />
                    <TextBlock Text="{Binding MaintenanceSeatsText}" Foreground="#FEE685" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2 CỘT DỮ LIỆU: SUẤT CHIẾU & HÓA ĐƠN -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- BẢNG SUẤT CHIẾU -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Lịch chiếu &amp; Tỷ lệ lấp đầy"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,14" />
                    <DataGrid Style="{StaticResource ModernDataGridStyle}"
                              ItemsSource="{Binding Showtimes}"
                              MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Phim" Binding="{Binding MovieTitle}" Width="*" />
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="120" />
                            <DataGridTextColumn Header="Giờ chiếu" Binding="{Binding StartTime}" Width="105" />
                            <DataGridTextColumn Header="Ghế bán" Binding="{Binding Occupancy}" Width="80" />
                            <DataGridTextColumn Header="Giá gốc" Binding="{Binding Price}" Width="90" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="105" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- HÓA ĐƠN GẦN ĐÂY -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Hóa đơn gần đây"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,14" />

                    <ItemsControl ItemsSource="{Binding RecentOrders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#18181B"
                                        BorderBrush="#23252A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding OrderCode}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding TotalAmount}"
                                                   FontWeight="Bold"
                                                   Foreground="#5E6AD2" />

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource MutedCaptionTextStyle}">
                                            <Run Text="{Binding CustomerName, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding Channel, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Margin="0,4,0,0"
                                                   Text="{Binding StatusDisplay}"
                                                   FontSize="11"
                                                   Foreground="#A4F4CF"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
