<UserControl x:Class="CinemaManageProject.Views.Customer.CustomerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel>
        <!-- THẺ HỘI VIÊN & ĐIỂM THƯỞNG -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Style="{StaticResource BadgeBorderStyle}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource CinemaVectorIconStyle}"
                                  Width="12" Height="12"
                                  Data="{StaticResource StarMembershipIconGeometry}"
                                  Stroke="#7C86FF"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TierDisplay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#5E6AD2" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding MemberName}"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Margin="0,2,0,0">
                        <Run Text="SĐT thành viên: " />
                        <Run Text="{Binding MemberPhone, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="1" Background="#18181B" CornerRadius="8" Padding="18,12" Margin="14,0">
                    <StackPanel>
                        <TextBlock Text="ĐIỂM TÍCH LŨY" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        <TextBlock Text="{Binding PointsText}" FontSize="20" FontWeight="Bold" Foreground="#5E6AD2" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#18181B" CornerRadius="8" Padding="18,12" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="TỔNG CHI TIÊU" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        <TextBlock Text="{Binding TotalSpentText}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#18181B" CornerRadius="8" Padding="18,12">
                    <StackPanel>
                        <TextBlock Text="VÉ ĐÃ ĐẶT" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        <TextBlock Text="{Binding ActiveTicketsText}" FontSize="20" FontWeight="Bold" Foreground="#A4F4CF" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- TIÊU ĐỀ & BỘ LỌC PHIM -->
        <DockPanel Margin="0,0,0,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource CinemaVectorIconStyle}"
                          Width="16" Height="16"
                          Data="{StaticResource FilmStripIconGeometry}"
                          Stroke="#7C86FF"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Phim tại CINEVERSE"
                               Style="{StaticResource SectionTitleTextStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Chọn một poster để xem thông tin giới thiệu chi tiết."
                           Style="{StaticResource MutedCaptionTextStyle}"
                           Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="FilterAllButton"
                        Content="Tất cả"
                        Style="{StaticResource FilterChipButtonStyle}"
                        Tag="{Binding AllFilterTag}"
                        Margin="0,0,8,0"
                        Click="OnFilterClick" />
                <Button x:Name="FilterNowShowingButton"
                        Content="Đang chiếu"
                        Style="{StaticResource FilterChipButtonStyle}"
                        Tag="{Binding NowShowingFilterTag}"
                        Margin="0,0,8,0"
                        Click="OnFilterClick" />
                <Button x:Name="FilterComingSoonButton"
                        Content="Sắp chiếu"
                        Style="{StaticResource FilterChipButtonStyle}"
                        Tag="{Binding ComingSoonFilterTag}"
                        Click="OnFilterClick" />
            </StackPanel>
        </DockPanel>

        <!-- DẢI POSTER TRƯỢT NGANG -->
        <Grid Margin="0,0,0,16">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasNoMovies}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ScrollLeftButton"
                    Grid.Column="0"
                    Content="‹"
                    FontSize="20"
                    FontWeight="Bold"
                    Width="34"
                    Height="80"
                    Padding="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Cuộn sang trái"
                    Click="OnScrollLeftClick" />

            <ScrollViewer x:Name="PosterStripScrollViewer"
                          Grid.Column="1"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly"
                          ScrollChanged="OnPosterStripScrollChanged"
                          PreviewMouseWheel="OnPosterStripPreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding Movies}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PosterCardButtonStyle}"
                                    Width="168"
                                    Margin="0,0,12,0"
                                    Tag="{Binding ActiveTag}"
                                    Click="OnMovieCardClick">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="208" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="#18181B"
                                            CornerRadius="8"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="Chưa có poster"
                                                       FontSize="11"
                                                       Foreground="#71717A"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="8" />
                                            <Image Source="{Binding PosterImage}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>

                                    <DockPanel Grid.Row="1" Margin="0,8,0,4" LastChildFill="False">
                                        <Border DockPanel.Dock="Left"
                                                Style="{StaticResource BadgeBorderStyle}"
                                                Background="#220084D1"
                                                Padding="8,2">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="#74D4FF" />
                                        </Border>
                                        <Border DockPanel.Dock="Right"
                                                Style="{StaticResource BadgeBorderStyle}"
                                                Background="#18181B"
                                                Padding="8,2">
                                            <TextBlock Text="{Binding AgeRating}" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </DockPanel>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Top" />

                                    <TextBlock Grid.Row="3"
                                               Text="{Binding Genres}"
                                               FontSize="11"
                                               Foreground="#A1A1AA"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,4" />

                                    <TextBlock Grid.Row="4"
                                               Text="{Binding PriceText}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#5E6AD2" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button x:Name="ScrollRightButton"
                    Grid.Column="2"
                    Content="›"
                    FontSize="20"
                    FontWeight="Bold"
                    Width="34"
                    Height="80"
                    Padding="0"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Cuộn sang phải"
                    Click="OnScrollRightClick" />
        </Grid>

        <!-- TRẠNG THÁI TRỐNG KHI KHÔNG CÓ PHIM -->
        <Border Style="{StaticResource CardBorderStyle}"
                Visibility="{Binding HasNoMovies, Converter={StaticResource BoolToVis}}"
                Margin="0,0,0,22">
            <TextBlock Text="Hiện chưa có phim nào phù hợp với bộ lọc đã chọn."
                       Style="{StaticResource MutedCaptionTextStyle}" />
        </Border>

        <!-- KHUNG GIỚI THIỆU PHIM ĐANG CHỌN -->
        <Border Style="{StaticResource CardBorderStyle}"
                Visibility="{Binding HasSelectedMovie, Converter={StaticResource BoolToVis}}"
                Margin="0,0,0,22">
            <Grid DataContext="{Binding SelectedMovie}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="148" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="214"
                        Background="#18181B"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True"
                        VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="Chưa có poster"
                                   FontSize="12"
                                   Foreground="#71717A"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="10" />
                        <Image Source="{Binding PosterImage}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource BadgeBorderStyle}" Background="#265E6AD2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource CinemaVectorIconStyle}"
                                      Width="12" Height="12"
                                      Data="{StaticResource FilmClapperIconGeometry}"
                                      Stroke="#7C86FF"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="GIỚI THIỆU PHIM" FontSize="11" FontWeight="Bold" Foreground="#7C86FF" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource BadgeBorderStyle}" Background="#220084D1" Margin="0,0,8,0">
                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#74D4FF" />
                        </Border>
                        <Border Style="{StaticResource BadgeBorderStyle}" Background="#18181B" Margin="0,0,10,0">
                            <TextBlock Text="{Binding AgeRating}" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{Binding ReleaseDateText}"
                                   Style="{StaticResource MutedCaptionTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding OriginalTitle}"
                                   Style="{StaticResource MutedCaptionTextStyle}"
                                   FontSize="13"
                                   Visibility="{Binding HasOriginalTitle, Converter={StaticResource BoolToVis}}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run Text="{Binding Genres, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FAFAFA" />
                            <Run Text="  •  " Foreground="#71717A" />
                            <Run Text="{Binding MetaInfo, Mode=OneWay}" Foreground="#A1A1AA" />
                        </TextBlock>
                        <TextBlock Text="{Binding DirectorText}"
                                   Style="{StaticResource MutedCaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="{Binding CastText}"
                                   Style="{StaticResource MutedCaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="{Binding DescriptionText}"
                                   FontSize="13"
                                   Foreground="#D4D4D8"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <Line X1="0" Y1="0" X2="1" Y2="0"
                              Stretch="Fill"
                              Height="1"
                              Stroke="#303440"
                              StrokeThickness="1"
                              StrokeDashArray="4 3"
                              Margin="0,0,0,10" />
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource CinemaVectorIconStyle}"
                                      Width="15" Height="15"
                                      Data="{StaticResource CinemaTicketIconGeometry}"
                                      Stroke="#7C86FF"
                                      Margin="0,0,7,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PriceText}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#5E6AD2"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="Giá chuẩn theo loại phòng &amp; hạng ghế"
                                       Style="{StaticResource MutedCaptionTextStyle}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- VÉ ĐÃ ĐẶT CỦA TÔI -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Path Style="{StaticResource CinemaVectorIconStyle}"
                          Width="16" Height="16"
                          Data="{StaticResource CinemaTicketIconGeometry}"
                          Stroke="#A4F4CF"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Vé của tôi"
                               Style="{StaticResource SectionTitleTextStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <DataGrid Style="{StaticResource ModernDataGridStyle}"
                          ItemsSource="{Binding MyTickets}"
                          MaxHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã vé" Binding="{Binding TicketCode}" Width="125" />
                        <DataGridTextColumn Header="Phim" Binding="{Binding MovieTitle}" Width="*" />
                        <DataGridTextColumn Header="Phòng &amp; Ghế" Binding="{Binding RoomAndSeat}" Width="180" />
                        <DataGridTextColumn Header="Suất chiếu" Binding="{Binding StartTime}" Width="140" />
                        <DataGridTextColumn Header="Giá vé" Binding="{Binding UnitPrice}" Width="100" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="115" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Bạn chưa có vé nào được đặt trong hệ thống."
                           Visibility="{Binding HasNoTickets, Converter={StaticResource BoolToVis}}"
                           Style="{StaticResource MutedCaptionTextStyle}"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
