<UserControl x:Class="CinemaManageProject.Views.Admin.AdminShowtimesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="988"
             d:DesignHeight="860"
             d:Background="#09090B">

    <StackPanel>
        <!-- ==================== HEADER ==================== -->
        <DockPanel Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Quản lý Lịch chiếu"
                           Style="{StaticResource PageTitleTextStyle}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Sắp xếp suất chiếu theo phim và phòng, tự động cộng 15 phút dọn phòng và chặn trùng giờ trong cùng phòng."
                           Style="{StaticResource MutedCaptionTextStyle}" />
            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Content="+ Thêm suất chiếu"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Center"
                    Click="OnNewShowtimeClick" />
        </DockPanel>

        <!-- ==================== THANH TÌM KIẾM & BỘ LỌC ==================== -->
        <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="165" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tìm kiếm (phim, phòng, định dạng)" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Height="38"
                             Padding="12,0"
                             ToolTip="Tìm theo tên phim, tên phòng hoặc định dạng"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ngày chiếu" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                              Height="38"
                              ItemsSource="{Binding DateFilterOptions}"
                              SelectedItem="{Binding SelectedDateFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Phòng chiếu" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                              Height="38"
                              ItemsSource="{Binding RoomFilterOptions}"
                              SelectedItem="{Binding SelectedRoomFilter, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Trạng thái" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                              Height="38"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilterOption, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                </StackPanel>

                <Button Grid.Column="8"
                        Content="Đặt lại"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="38"
                        Padding="14,0"
                        VerticalAlignment="Bottom"
                        Click="OnResetFiltersClick" />
            </Grid>
        </Border>

        <!-- ==================== BẢNG DANH SÁCH SUẤT CHIẾU (FULL CHIỀU NGANG) ==================== -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,12" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Danh sách Suất chiếu"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="0,0,14,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SummaryStatsText}"
                                   Style="{StaticResource MutedCaptionTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ResultCountText, FallbackValue='0 suất chiếu'}"
                               Style="{StaticResource MutedCaptionTextStyle}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <DataGrid Style="{StaticResource ModernDataGridStyle}"
                          ItemsSource="{Binding Showtimes}"
                          SelectedItem="{Binding SelectedShowtime, Mode=TwoWay}"
                          MinHeight="230"
                          MaxHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Phim" Binding="{Binding MovieTitle}" Width="*" MinWidth="180" />
                        <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="134" />
                        <DataGridTextColumn Header="Ngày" Binding="{Binding ShowDateDisplay}" Width="106" />
                        <DataGridTextColumn Header="Khung giờ" Binding="{Binding TimeRangeDisplay}" Width="114" />
                        <DataGridTextColumn Header="Giá chuẩn" Binding="{Binding StandardSeatPriceText}" Width="92" />
                        <DataGridTextColumn Header="Đã đặt" Binding="{Binding OccupancyDisplay}" Width="74" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="128" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- ==================== FORM CHI TIẾT SUẤT CHIẾU (2 CỘT CÂN ĐỐI) ==================== -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <DockPanel Margin="0,0,0,14" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding FormHeaderText, FallbackValue='Thêm suất chiếu mới'}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               VerticalAlignment="Center" />
                    <Border DockPanel.Dock="Right" Style="{StaticResource BadgeBorderStyle}">
                        <TextBlock Text="{Binding FormModeBadge, FallbackValue='THÊM MỚI'}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#5E6AD2" />
                    </Border>
                </DockPanel>

                <!-- THÔNG BÁO LỖI / THÀNH CÔNG / KHÓA VÉ -->
                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                        Background="#24C10007"
                        BorderBrush="#FFC9C9"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FFC9C9"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <Border Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                        Background="#22166534"
                        BorderBrush="#A4F4CF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="#A4F4CF"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <Border Visibility="{Binding SelectedHasActiveTickets, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                        Background="#265E6AD2"
                        BorderBrush="#5E6AD2"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <TextBlock Text="{Binding ActiveTicketsNoticeText}"
                               Foreground="#E0E7FF"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- NỬA TRÁI FORM -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phim chiếu *" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                                  Height="38"
                                  ItemsSource="{Binding MovieOptions}"
                                  SelectedItem="{Binding SelectedMovieOption, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayLabel"
                                  IsEnabled="{Binding CanEditScheduleCore, FallbackValue=True}"
                                  Margin="0,0,0,12" />

                        <TextBlock Text="Phòng chiếu *" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                                  Height="38"
                                  ItemsSource="{Binding RoomOptions}"
                                  SelectedItem="{Binding SelectedRoomOption, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayLabel"
                                  IsEnabled="{Binding CanEditScheduleCore, FallbackValue=True}"
                                  Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ngày chiếu (dd/MM/yyyy) *" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                         Height="38"
                                         Padding="12,0"
                                         IsEnabled="{Binding CanEditScheduleCore, FallbackValue=True}"
                                         Text="{Binding ShowDateText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Giờ bắt đầu (HH:mm) *" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                         Height="38"
                                         Padding="12,0"
                                         IsEnabled="{Binding CanEditScheduleCore, FallbackValue=True}"
                                         Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Border Background="#18181B"
                                BorderBrush="#23252A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="Giờ kết thúc dự kiến (tự động +15 phút dọn phòng)"
                                           FontSize="11"
                                           Foreground="#71717A"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="{Binding PreviewEndTimeText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FAFAFA"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- NỬA PHẢI FORM -->
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Định dạng chiếu *" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                         Height="38"
                                         Padding="12,0"
                                         Text="{Binding FormatText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Giá chuẩn rạp (Cố định)" Style="{StaticResource FieldLabelTextStyle}" />
                                <Border Background="#18181B"
                                        BorderBrush="#23252A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,0"
                                        Height="38">
                                    <TextBlock Text="{Binding StandardBasePriceDisplay, FallbackValue='80.000đ'}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#FAFAFA"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Bảng giá theo loại phòng &amp; hạng ghế" Style="{StaticResource FieldLabelTextStyle}" />
                        <Border Background="#18181B"
                                BorderBrush="#23252A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding PreviewPriceSummaryText}"
                                       FontSize="12"
                                       Foreground="#A1A1AA"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Trạng thái suất chiếu *" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                                  Height="38"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatusOption, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="Lưu suất chiếu"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnSaveShowtimeClick" />
                            <Button Grid.Column="2"
                                    Content="Làm mới"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnResetFormClick" />
                            <Button Grid.Column="4"
                                    Content="Xóa"
                                    Style="{StaticResource DangerButtonStyle}"
                                    IsEnabled="{Binding IsEditMode, FallbackValue=False}"
                                    Click="OnDeleteShowtimeClick" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
