<UserControl x:Class="CinemaManageProject.Views.Customer.CustomerBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="988"
             d:DesignHeight="1040"
             d:Background="#09090B">

    <StackPanel>
        <!-- HEADER -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Phim &amp; Lịch chiếu — Đặt vé Trực tuyến"
                           Style="{StaticResource PageTitleTextStyle}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Chọn phim, chọn suất chiếu phù hợp, tự chọn ghế ngồi và thanh toán trực tuyến."
                           Style="{StaticResource MutedCaptionTextStyle}" />
            </StackPanel>
            <Border Grid.Column="1"
                    Style="{StaticResource BadgeBorderStyle}"
                    VerticalAlignment="Center"
                    Padding="12,6">
                <TextBlock Text="{Binding MemberHeaderText}" FontSize="12" FontWeight="SemiBold" Foreground="#A5B4FC" />
            </Border>
        </Grid>

        <!-- THÔNG BÁO -->
        <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#24C10007" BorderBrush="#FFC9C9" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFC9C9" FontSize="12" TextWrapping="Wrap" />
        </Border>
        <Border Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#22166534" BorderBrush="#A4F4CF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="#A4F4CF" FontSize="12" TextWrapping="Wrap" />
        </Border>
        <Border Visibility="{Binding HasLastBooking, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#1B1E2E" BorderBrush="#5E6AD2" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="XÁC NHẬN ĐẶT VÉ TRỰC TUYẾN" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LastBookingSummary}" FontSize="12" Foreground="#FAFAFA" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- BƯỚC 1: CHỌN PHIM & SUẤT CHIẾU -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <Button Content="Đang chiếu" Tag="{Binding NowShowingTag}" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,6,0" Click="OnFilterNowShowingClick" />
                        <Button Content="Sắp chiếu" Tag="{Binding ComingSoonTag}" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,6,0" Click="OnFilterComingSoonClick" />
                        <Button Content="Tất cả" Tag="{Binding AllStatusTag}" Style="{StaticResource FilterChipButtonStyle}" Click="OnFilterAllClick" />
                    </WrapPanel>

                    <ComboBox Grid.Column="1"
                              Style="{StaticResource ModernComboBoxStyle}"
                              FontSize="12"
                              Padding="10,6"
                              ItemsSource="{Binding GenreOptions}"
                              SelectedItem="{Binding SelectedGenre, Mode=TwoWay}" />

                    <TextBox Grid.Column="3"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Padding="10,6"
                             FontSize="12"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Tìm theo tên phim, đạo diễn, thể loại..." />
                </Grid>

                <TextBlock Text="Không tìm thấy phim phù hợp bộ lọc hiện tại."
                           Visibility="{Binding HasNoMovies, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                           Style="{StaticResource MutedCaptionTextStyle}"
                           Margin="0,6,0,6" />

                <!-- DẢI POSTER PHIM -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,14">
                    <ItemsControl ItemsSource="{Binding Movies}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PosterCardButtonStyle}"
                                        Tag="{Binding ActiveTag}"
                                        Width="156"
                                        Margin="0,0,10,0"
                                        Click="OnSelectMovieClick">
                                    <StackPanel>
                                        <Border Height="175" Background="#0F1011" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,8">
                                            <Grid>
                                                <Image Source="{Binding PosterImage}" Stretch="UniformToFill" />
                                                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6" Background="#CC09090B" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding AgeRating}" FontSize="10" FontWeight="Bold" Foreground="#FEE685" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ShowtimeBadgeText}" FontSize="11" Foreground="#A5B4FC" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding PriceText}" FontSize="11" Foreground="#A1A1AA" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- THÔNG TIN PHIM & DANH SÁCH SUẤT MỞ BÁN -->
                <Border Visibility="{Binding HasSelectedMovie, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                        Background="#18181B" BorderBrush="#23252A" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedMovie.Title}" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA" TextWrapping="Wrap" />
                                <TextBlock FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding SelectedMovie.MetaLine, Mode=OneWay}" />
                                    <Run Text=" • " />
                                    <Run Text="{Binding SelectedMovie.GenresText, Mode=OneWay}" Foreground="#A5B4FC" />
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedMovie.DescriptionText}" FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top" Margin="12,0,0,0">
                                <TextBlock Text="{Binding SelectedMovie.StatusDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#A4F4CF" />
                            </Border>
                        </Grid>

                        <TextBlock Text="Chọn Suất chiếu mở bán:" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,4,0,8" />

                        <TextBlock Text="Phim này hiện chưa có suất chiếu mở bán. Hãy chọn một phim Đang chiếu khác phía trên."
                                   Visibility="{Binding HasNoMovieShowtimes, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                   Style="{StaticResource MutedCaptionTextStyle}" />

                        <DataGrid Visibility="{Binding HasMovieShowtimes, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                  Style="{StaticResource CompactDataGridStyle}"
                                  ItemsSource="{Binding MovieShowtimes}"
                                  SelectedItem="{Binding SelectedShowtime, Mode=TwoWay}"
                                  MaxHeight="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ngày chiếu" Binding="{Binding ShowDateDisplay}" Width="96" MinWidth="88" />
                                <DataGridTextColumn Header="Khung giờ" Binding="{Binding TimeRangeDisplay}" Width="110" MinWidth="100" />
                                <DataGridTextColumn Header="Phòng chiếu" Binding="{Binding RoomName}" Width="*" MinWidth="120" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                                <DataGridTextColumn Header="Định dạng" Binding="{Binding Format}" Width="125" MinWidth="105" ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                                <DataGridTextColumn Header="Ghế trống" Binding="{Binding AvailabilityText}" Width="105" MinWidth="92" />
                                <DataGridTextColumn Header="Giá ghế thường" Binding="{Binding StandardPriceText}" Width="106" MinWidth="92" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- BƯỚC 2 & 3: SƠ ĐỒ GHẾ + THANH TOÁN TRỰC TUYẾN -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- SƠ ĐỒ GHẾ -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding SeatMapHeader}"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button DockPanel.Dock="Right"
                                Content="Bỏ chọn ghế"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="10,4"
                                FontSize="12"
                                Click="OnClearSeatsClick" />
                    </DockPanel>
                    <TextBlock Text="{Binding SeatMapSubtitle}" Style="{StaticResource MutedCaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <WrapPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                            <Border Width="14" Height="14" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                            <TextBlock Text="Thường" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                            <Border Width="14" Height="14" Background="#265E6AD2" BorderBrush="#5E6AD2" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                            <TextBlock Text="VIP" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                            <Border Width="24" Height="14" Background="#2B193D" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                            <TextBlock Text="Ghế Đôi" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                            <Border Width="14" Height="14" Background="#5E6AD2" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                            <TextBlock Text="Đang chọn" FontSize="11" Foreground="#FAFAFA" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                            <Border Width="14" Height="14" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                            <TextBlock Text="Đã đặt" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="14" Height="14" Background="#26C70036" BorderBrush="#E11D48" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                            <TextBlock Text="Bảo trì" FontSize="11" Foreground="#FDA4AF" VerticalAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>

                    <Border Background="#18181B" BorderBrush="#3F3F46" BorderThickness="0,2,0,0" CornerRadius="6" Padding="16,6" Margin="20,0,20,16">
                        <TextBlock Text="MÀN HÌNH CHIẾU" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" HorizontalAlignment="Center" />
                    </Border>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                        <ItemsControl ItemsSource="{Binding SeatRows}" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RowLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#71717A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Seats}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding SeatCode}"
                                                            ToolTip="{Binding ToolTipText}"
                                                            Style="{StaticResource BookingSeatButtonStyle}"
                                                            Click="OnSeatClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- THANH TOÁN TRỰC TUYẾN -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Tóm tắt Đặt vé Online"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,12" />

                    <Border Background="#18181B" BorderBrush="#23252A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="GHẾ ĐÃ CHỌN" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedSeatsText}" FontSize="12" Foreground="#FAFAFA" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Đổi điểm thưởng (1 điểm = 1.000đ, tối đa 50%)" Style="{StaticResource FieldLabelTextStyle}" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Padding="10,6"
                                 FontSize="13"
                                 Text="{Binding PointsToUseText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                Content="Dùng tối đa"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,7"
                                FontSize="12"
                                Click="OnApplyMaxPointsClick" />
                    </Grid>
                    <TextBlock Text="{Binding PointsHintText}" FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <TextBlock Text="Phương thức thanh toán trực tuyến" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                              ItemsSource="{Binding PaymentOptions}"
                              SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Ghi chú (tùy chọn)" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Padding="10,6"
                             FontSize="13"
                             Text="{Binding OrderNote, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14" />

                    <Border Background="#18181B" BorderBrush="#23252A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Text="Tạm tính:" FontSize="12" Foreground="#A1A1AA" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SubTotalText}" FontSize="12" Foreground="#FAFAFA" HorizontalAlignment="Right" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Text="Giảm điểm thưởng:" FontSize="12" Foreground="#A1A1AA" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DiscountText}" FontSize="12" Foreground="#A4F4CF" HorizontalAlignment="Right" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="Điểm tích thêm dự kiến:" FontSize="12" Foreground="#A1A1AA" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding EstimatedPointsText}" FontSize="12" Foreground="#FEE685" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Border Height="1" Background="#23252A" Margin="0,0,0,8" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="THANH TOÁN:" FontSize="13" FontWeight="Bold" Foreground="#FAFAFA" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalAmountText}" FontSize="16" FontWeight="Bold" Foreground="#5E6AD2" HorizontalAlignment="Right" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="Xác nhận Đặt vé"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding CanBook}"
                            Click="OnConfirmBookingClick" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
