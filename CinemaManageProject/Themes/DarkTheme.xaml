<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== DARK THEME (ZINC OBSIDIAN) ==================== -->

    <!-- Nền & Bề mặt (Zinc-950 -> Zinc-900 -> Zinc-800) -->
    <Color x:Key="BgPrimaryColor">#09090B</Color>
    <Color x:Key="BgSecondaryColor">#0F1011</Color>
    <Color x:Key="SurfaceCardColor">#141516</Color>
    <Color x:Key="SurfaceElevatedColor">#18181B</Color>
    <Color x:Key="SurfaceHoverColor">#27272A</Color>
    <Color x:Key="SurfacePressedColor">#34343A</Color>
    <Color x:Key="SurfaceDisabledColor">#141516</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="{StaticResource SurfaceDisabledColor}" />

    <!-- Chữ (Zinc-50 -> Zinc-400 -> Zinc-500) -->
    <Color x:Key="TextPrimaryColor">#FAFAFA</Color>
    <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
    <Color x:Key="TextMutedColor">#71717A</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
    <Color x:Key="TextOnDangerColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="TextOnDangerBrush" Color="{StaticResource TextOnDangerColor}" />

    <!-- Viền Hairline -->
    <Color x:Key="BorderSubtleColor">#23252A</Color>
    <Color x:Key="BorderStrongColor">#3F3F46</Color>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <!-- Màu nhấn chính (Zinc Indigo tối giản) -->
    <Color x:Key="AccentPrimaryColor">#5E6AD2</Color>
    <Color x:Key="AccentPrimaryHoverColor">#7C86FF</Color>
    <Color x:Key="AccentPrimaryPressedColor">#4F39F6</Color>
    <Color x:Key="AccentSoftColor">#265E6AD2</Color>

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource AccentPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="{StaticResource AccentPrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

    <!-- Màu nhấn phụ / Hủy / Cảnh báo -->
    <Color x:Key="AccentDangerColor">#C70036</Color>
    <Color x:Key="AccentDangerHoverColor">#E11D48</Color>
    <Color x:Key="AccentDangerPressedColor">#9F1239</Color>
    <Color x:Key="AccentDangerSoftColor">#26C70036</Color>

    <SolidColorBrush x:Key="AccentDangerBrush" Color="{StaticResource AccentDangerColor}" />
    <SolidColorBrush x:Key="AccentDangerHoverBrush" Color="{StaticResource AccentDangerHoverColor}" />
    <SolidColorBrush x:Key="AccentDangerPressedBrush" Color="{StaticResource AccentDangerPressedColor}" />
    <SolidColorBrush x:Key="AccentDangerSoftBrush" Color="{StaticResource AccentDangerSoftColor}" />

    <!-- Trạng thái hệ thống -->
    <Color x:Key="StatusSuccessColor">#A4F4CF</Color>
    <Color x:Key="StatusWarningColor">#FEE685</Color>
    <Color x:Key="StatusErrorColor">#FFC9C9</Color>
    <Color x:Key="StatusInfoColor">#74D4FF</Color>

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusSuccessSoftBrush" Color="#22007A55" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusWarningSoftBrush" Color="#24BB4D00" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusErrorSoftBrush" Color="#24C10007" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />
    <SolidColorBrush x:Key="StatusInfoSoftBrush" Color="#220084D1" />

    <!-- Ghế rạp chiếu phim (Minimal Zinc) -->
    <SolidColorBrush x:Key="SeatStandardBrush" Color="#18181B" />
    <SolidColorBrush x:Key="SeatStandardBorderBrush" Color="#27272A" />
    <SolidColorBrush x:Key="SeatVipBrush" Color="#22FF8903" />
    <SolidColorBrush x:Key="SeatVipBorderBrush" Color="#FF8903" />
    <SolidColorBrush x:Key="SeatCoupleBrush" Color="#228E51FF" />
    <SolidColorBrush x:Key="SeatCoupleBorderBrush" Color="#A684FF" />
    <SolidColorBrush x:Key="SeatSelectedBrush" Color="#5E6AD2" />
    <SolidColorBrush x:Key="SeatUnavailableBrush" Color="#27272A" />
    <SolidColorBrush x:Key="SeatMaintenanceBrush" Color="#0F1011" />
    <SolidColorBrush x:Key="ScreenCurveBrush" Color="#5E6AD2" />

</ResourceDictionary>
