<UserControl x:Class="CinemaManageProject.Views.Staff.StaffPosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="988"
             d:DesignHeight="1120"
             d:Background="#09090B">

    <StackPanel>
        <!-- HEADER -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Bán vé tại Quầy (POS)"
                       Style="{StaticResource PageTitleTextStyle}"
                       Margin="0,0,0,4" />
            <TextBlock Text="Lướt chọn phim đang mở bán, chọn suất chiếu bên trái, chọn ghế phòng chiếu và xuất hóa đơn ngay bên dưới."
                       Style="{StaticResource MutedCaptionTextStyle}" />
        </StackPanel>

        <!-- THÔNG BÁO LỖI / THÀNH CÔNG -->
        <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#24C10007"
                BorderBrush="#FFC9C9"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFC9C9" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <Border Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#22166534"
                BorderBrush="#A4F4CF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="#A4F4CF" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- PHIẾU XÁC NHẬN VỪA XUẤT -->
        <Border Visibility="{Binding HasLastReceipt, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="#1B1E2E"
                BorderBrush="#5E6AD2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="HÓA ĐƠN VỪA PHÁT HÀNH" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LastReceiptSummary}" FontSize="12" Foreground="#FAFAFA" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- BƯỚC 1: LƯỚT POSTER PHIM ĐANG MỞ BÁN -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="1. Chọn Phim đang mở bán"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="Bấm vào poster để lọc nhanh suất của phim đó (bấm lại để xem toàn bộ)."
                                   Style="{StaticResource MutedCaptionTextStyle}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="{Binding AllMoviesButtonText}"
                            Tag="{Binding AllMoviesTag}"
                            Style="{StaticResource FilterChipButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnShowAllMoviesClick" />

                    <TextBox Grid.Column="3"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Padding="10,6"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Tìm nhanh theo tên phim, phòng hoặc định dạng..." />

                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ScrollLeftButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="32" Height="32"
                                Padding="0"
                                Margin="0,0,6,0"
                                ToolTip="Lướt sang trái"
                                Click="OnScrollLeftClick">
                            <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="ScrollRightButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="32" Height="32"
                                Padding="0"
                                ToolTip="Lướt sang phải"
                                Click="OnScrollRightClick">
                            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Không có phim mở bán nào khớp từ khóa tìm kiếm."
                           Visibility="{Binding HasNoMovies, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                           Style="{StaticResource MutedCaptionTextStyle}"
                           Margin="0,4,0,4" />

                <!-- DẢI LƯỚT POSTER PHIM -->
                <ScrollViewer x:Name="PosterStripScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              ScrollChanged="OnPosterStripScrollChanged"
                              PreviewMouseWheel="OnPosterStripPreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Movies}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PosterCardButtonStyle}"
                                        Tag="{Binding ActiveTag}"
                                        Width="156"
                                        Margin="0,0,10,12"
                                        Click="OnSelectMovieClick">
                                    <StackPanel>
                                        <Border Height="175" Background="#0F1011" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,8">
                                            <Grid>
                                                <Image Source="{Binding PosterImage}" Stretch="UniformToFill" />
                                                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6" Background="#CC09090B" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding AgeRating}" FontSize="10" FontWeight="Bold" Foreground="#FEE685" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ShowtimeBadgeText}" FontSize="11" Foreground="#A5B4FC" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding PriceText}" FontSize="11" Foreground="#A1A1AA" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- BƯỚC 2 & 3: TRÁI = CHỌN SUẤT CHIẾU MỞ BÁN | PHẢI = SƠ ĐỒ GHẾ (TRÊN) + THANH TOÁN & XUẤT VÉ (DƯỚI) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="296" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: DANH SÁCH SUẤT CHIẾU MỞ BÁN -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="2. Suất chiếu mở bán"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ShowtimeListSubtitle}"
                               Style="{StaticResource MutedCaptionTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Không có suất chiếu mở bán phù hợp."
                               Visibility="{Binding HasNoShowtimes, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                               Style="{StaticResource MutedCaptionTextStyle}"
                               TextWrapping="Wrap" />

                    <ListBox ItemsSource="{Binding Showtimes}"
                             SelectedItem="{Binding SelectedShowtime, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ShowtimeCardItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MaxHeight="820">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding MovieTitle}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#A5B4FC"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,4" />

                                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding TimeRangeDisplay}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#FAFAFA"
                                                   VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Right"
                                                Background="#141516"
                                                BorderBrush="#2E303A"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="7,2">
                                            <TextBlock Text="{Binding ShowDateDisplay}"
                                                       FontSize="11"
                                                       Foreground="#A1A1AA" />
                                        </Border>
                                    </DockPanel>

                                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,6">
                                        <Run Text="{Binding RoomName, Mode=OneWay}" Foreground="#E4E4E7" FontWeight="SemiBold" />
                                        <Run Text=" • " Foreground="#71717A" />
                                        <Run Text="{Binding Format, Mode=OneWay}" Foreground="#A1A1AA" />
                                    </TextBlock>

                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding AvailabilityText}"
                                                   FontSize="11"
                                                   Foreground="#A4F4CF"
                                                   VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding StandardPriceText}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#FAFAFA"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- CỘT PHẢI: SƠ ĐỒ GHẾ (TRÊN) + THANH TOÁN & XUẤT VÉ (DƯỚI) -->
            <StackPanel Grid.Column="2">
                <!-- SƠ ĐỒ GHẾ -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding SeatMapHeader}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button DockPanel.Dock="Right"
                                    Content="Bỏ chọn ghế"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="10,4"
                                    FontSize="12"
                                    Click="OnClearSeatsClick" />
                        </DockPanel>
                        <TextBlock Text="{Binding SeatMapSubtitle}"
                                   Style="{StaticResource MutedCaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <!-- CHÚ THÍCH MÀU -->
                        <WrapPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                <Border Width="14" Height="14" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                                <TextBlock Text="Thường (×1.0)" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                <Border Width="14" Height="14" Background="#265E6AD2" BorderBrush="#5E6AD2" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                                <TextBlock Text="VIP (×1.25)" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                <Border Width="24" Height="14" Background="#2B193D" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                                <TextBlock Text="Đôi (×2.0)" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                <Border Width="14" Height="14" Background="#5E6AD2" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                                <TextBlock Text="Đang chọn" FontSize="11" Foreground="#FAFAFA" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                <Border Width="14" Height="14" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                                <TextBlock Text="Đã đặt" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="14" Height="14" Background="#26C70036" BorderBrush="#E11D48" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" />
                                <TextBlock Text="Bảo trì" FontSize="11" Foreground="#FDA4AF" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>

                        <!-- MÀN HÌNH CHIẾU -->
                        <Border Background="#18181B"
                                BorderBrush="#3F3F46"
                                BorderThickness="0,2,0,0"
                                CornerRadius="6"
                                Padding="16,6"
                                Margin="20,0,20,16">
                            <TextBlock Text="MÀN HÌNH CHIẾU"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#A1A1AA"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <!-- LƯỚI GHẾ -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="440">
                            <ItemsControl ItemsSource="{Binding SeatRows}" HorizontalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding RowLabel}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#71717A"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />

                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Seats}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding SeatCode}"
                                                                ToolTip="{Binding ToolTipText}"
                                                                Style="{StaticResource BookingSeatButtonStyle}"
                                                                Click="OnSeatClick" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 3. THANH TOÁN & XUẤT VÉ (NẰM DƯỚI CHỌN GHẾ) -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="3. Thanh toán &amp; Xuất vé"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="278" />
                            </Grid.ColumnDefinitions>

                            <!-- TRÁI: GHẾ ĐANG CHỌN + HỘI VIÊN + ĐIỂM + PTTT + TIỀN MẶT + GHI CHÚ -->
                            <StackPanel Grid.Column="0">
                                <!-- GHẾ ĐANG CHỌN -->
                                <Border Background="#18181B" BorderBrush="#23252A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="GHẾ ĐANG CHỌN" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SelectedSeatsText}" FontSize="12" Foreground="#FAFAFA" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- TRA CỨU HỘI VIÊN -->
                                <TextBlock Text="Hội viên (nhập SĐT — để trống = khách vãng lai)" Style="{StaticResource FieldLabelTextStyle}" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Padding="10,6"
                                             FontSize="13"
                                             Text="{Binding CustomerPhoneInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2"
                                            Content="Tìm"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,7"
                                            FontSize="12"
                                            Click="OnLookupCustomerClick" />
                                    <Button Grid.Column="4"
                                            Content="Bỏ"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,7"
                                            FontSize="12"
                                            Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                            Click="OnClearCustomerClick" />
                                </Grid>
                                <TextBlock Text="{Binding CustomerDisplayText}" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding CustomerPointsInfoText}" FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <!-- ĐỔI ĐIỂM THƯỞNG -->
                                <StackPanel Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" Margin="0,0,0,12">
                                    <TextBlock Text="Đổi điểm thưởng (1 điểm = 1.000đ, tối đa 50%)" Style="{StaticResource FieldLabelTextStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Padding="10,6"
                                                 FontSize="13"
                                                 Text="{Binding PointsToUseText, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2"
                                                Content="Dùng tối đa"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,7"
                                                FontSize="12"
                                                Click="OnApplyMaxPointsClick" />
                                    </Grid>
                                </StackPanel>

                                <!-- PHƯƠNG THỨC THANH TOÁN & GHI CHÚ -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Phương thức thanh toán" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                                                  ItemsSource="{Binding PaymentOptions}"
                                                  SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ghi chú hóa đơn (tùy chọn)" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Padding="10,7"
                                                 FontSize="13"
                                                 Text="{Binding OrderNote, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!-- TIỀN KHÁCH ĐƯA (CHỈ HIỆN KHI CHỌN TIỀN MẶT) -->
                                <StackPanel Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
                                    <TextBlock Text="Tiền khách đưa (VNĐ)" Style="{StaticResource FieldLabelTextStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Padding="10,6"
                                                 FontSize="13"
                                                 Text="{Binding CashReceivedText, UpdateSourceTrigger=PropertyChanged}" />
                                        <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="Đúng tiền" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,5,0" Click="OnExactCashClick" />
                                            <Button Content="100k" Tag="100000" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,5,0" Click="OnQuickCashClick" />
                                            <Button Content="200k" Tag="200000" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,5,0" Click="OnQuickCashClick" />
                                            <Button Content="500k" Tag="500000" Style="{StaticResource FilterChipButtonStyle}" Click="OnQuickCashClick" />
                                        </WrapPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- PHẢI: TỔNG TIỀN + NÚT XUẤT VÉ -->
                            <StackPanel Grid.Column="2">
                                <Border Background="#18181B" BorderBrush="#23252A" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Left" Text="Tạm tính:" FontSize="12" Foreground="#A1A1AA" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SubTotalText}" FontSize="12" Foreground="#FAFAFA" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Left" Text="Giảm điểm thưởng:" FontSize="12" Foreground="#A1A1AA" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DiscountText}" FontSize="12" Foreground="#A4F4CF" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <Border Height="1" Background="#23252A" Margin="0,0,0,10" />
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Left" Text="TỔNG THANH TOÁN:" FontSize="13" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalAmountText}" FontSize="18" FontWeight="Bold" Foreground="#5E6AD2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DockPanel Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
                                            <TextBlock DockPanel.Dock="Left" Text="Tiền thối lại:" FontSize="12" Foreground="#A1A1AA" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeAmountText}" FontSize="13" FontWeight="SemiBold" Foreground="#FEE685" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Button Content="Xuất vé &amp; Thanh toán"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="16,11"
                                        IsEnabled="{Binding CanCheckout}"
                                        Click="OnCompleteSaleClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
